@using Microsoft.AspNetCore.Identity
@inject SignInManager<Read_It.Models.ApplicationUser> SignInManager
@inject UserManager<Read_It.Models.ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link text-light" href="/User/Details">Hello @User.Identity?.Name!</a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="nav-link btn btn-link text-light">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-light" href="/Account/Login">Login</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-light" href="/Account/Register">Register</a>
    </li>
}
</ul>
