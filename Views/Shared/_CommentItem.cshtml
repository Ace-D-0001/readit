@model Read_It.Models.Comment

@{
    var userCommentVotes = ViewBag.UserCommentVotes as Dictionary<int, int> ?? new Dictionary<int, int>();
    int myVote = userCommentVotes.ContainsKey(Model.Id) ? userCommentVotes[Model.Id] : 0;
    string authorName = Model.User?.UserName ?? "student";
    bool isAdmin = User.IsInRole("Admin");
    string? currentUserId = ViewBag.CurrentUserId as string;
    bool isPostAuthor = (Model.Post != null && !string.IsNullOrEmpty(currentUserId) && Model.Post.UserId == currentUserId);
}

<div class="comment-card card p-3 @(Model.IsAcceptedSolution ? "border-success bg-opacity-10" : "")" id="comment-@Model.Id" style="@(Model.IsAcceptedSolution ? "border-left: 5px solid var(--success); background: rgba(34, 197, 94, 0.08);" : "")">
    <div style="display: flex; gap: var(--sp-3);">
        <!-- Avatar -->
        <div class="avatar avatar-sm" style="background: @(authorName == "admin" ? "var(--warning)" : "var(--accent)"); color: @(authorName == "admin" ? "#000" : "#fff"); font-weight: 800; flex-shrink: 0;">
            @authorName.Substring(0, 1).ToUpper()
        </div>

        <div style="flex: 1; min-width: 0;">
            <!-- Comment Meta Header -->
            <div class="comment-meta flex-wrap">
                <a href="@Url.Action("Details", "User", new { username = authorName })" class="comment-author">
                    u/@authorName
                </a>
                @if (authorName == "admin")
                {
                    <span class="badge bg-warning text-dark font-weight-bold" style="font-size: 10px; padding: 1px 4px;">ADMIN</span>
                }
                @if (Model.IsAcceptedSolution)
                {
                    <span class="badge bg-success text-white font-weight-bold" style="font-size: 11px;">
                        <i class="bi bi-check-circle-fill"></i> Accepted Solution
                    </span>
                }
                <span>·</span>
                <span>@Model.CreatedAt.ToString("MMM dd 'at' hh:mm tt")</span>
            </div>

            <!-- Comment Body -->
            <p class="comment-body">@Model.Body</p>

            <!-- Actions: Vote, Accept Solution & Reply -->
            <div class="comment-actions" style="display: flex; align-items: center; gap: var(--sp-3); flex-wrap: wrap;">
                @if (!isAdmin)
                {
                    <!-- Vote Form for Students -->
                    <div style="display: flex; align-items: center; gap: 4px;">
                        <form action="@Url.Action("Vote", "Posts")" method="post" style="margin: 0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="targetId" value="@Model.Id" />
                            <input type="hidden" name="targetType" value="comment" />
                            <input type="hidden" name="direction" value="1" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="vote-arrow up @(myVote == 1 ? "upvoted" : "")" title="Upvote" style="font-size: 13px;">
                                <i class="bi bi-arrow-up-circle-fill"></i>
                            </button>
                        </form>

                        <span style="font-size: var(--text-xs); font-weight: 700; color: @(myVote == 1 ? "var(--upvote)" : "var(--text-secondary)");">
                            @Model.UpVotes
                        </span>

                        <form action="@Url.Action("Vote", "Posts")" method="post" style="margin: 0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="targetId" value="@Model.Id" />
                            <input type="hidden" name="targetType" value="comment" />
                            <input type="hidden" name="direction" value="-1" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="vote-arrow down @(myVote == -1 ? "downvoted" : "")" title="Downvote" style="font-size: 13px;">
                                <i class="bi bi-arrow-down-circle-fill"></i>
                            </button>
                        </form>
                    </div>

                    <!-- Report Toggle Button -->
                    <button type="button" class="action-btn text-muted" onclick="toggleReportForm(@Model.Id)" style="font-size: 11px;">
                        <i class="bi bi-flag"></i> Report
                    </button>
                }
                else
                {
                    <span class="badge bg-dark border text-muted" style="font-size: 11px;">
                        Score: @Model.UpVotes
                    </span>

                    <!-- Admin Delete Action -->
                    <form action="/Admin/DeleteComment" method="post" style="margin: 0;" onsubmit="return confirm('Delete this comment?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="commentId" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button type="submit" class="action-btn" style="color: var(--error); font-size: 11px;">
                            <i class="bi bi-trash-fill"></i> Delete Comment
                        </button>
                    </form>
                }

                <!-- Accept Solution Action (Post author or Admin) -->
                @if (isPostAuthor || isAdmin)
                {
                    <form action="/Posts/MarkAcceptedSolution" method="post" style="margin: 0;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="postId" value="@Model.PostId" />
                        <input type="hidden" name="commentId" value="@Model.Id" />
                        <button type="submit" class="action-btn @(Model.IsAcceptedSolution ? "text-success fw-bold" : "text-muted")" style="font-size: 11px;" title="Mark this answer as accepted solution">
                            <i class="bi @(Model.IsAcceptedSolution ? "bi-check-circle-fill" : "bi-check-circle")"></i>
                            @(Model.IsAcceptedSolution ? "Accepted Solution" : "Accept Answer")
                        </button>
                    </form>
                }

                <!-- Reply Toggle Button -->
                @if (Model.Post?.IsLocked != true)
                {
                    <button type="button" class="action-btn" onclick="toggleReplyForm(@Model.Id)">
                        <i class="bi bi-reply-fill"></i> Reply
                    </button>
                }
            </div>

            @if (!isAdmin)
            {
                <!-- Inline Report Comment Form -->
                <div id="report-comment-form-@Model.Id" class="comment-reply-box" style="display: none; margin-top: var(--sp-2); border-left: 3px solid var(--warning);">
                    <form action="/Posts/ReportComment" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="commentId" value="@Model.Id" />
                        <div style="font-size: 11px; font-weight: 700; color: var(--warning); margin-bottom: 4px;">Report this comment</div>
                        <select name="reason" class="form-select form-select-sm mb-2" style="font-size: 11px; background: var(--bg-panel); color: white;">
                            <option value="Inappropriate Content">Inappropriate Content</option>
                            <option value="Harassment or Abuse">Harassment or Abuse</option>
                            <option value="Spam / Misleading">Spam / Misleading</option>
                            <option value="Off-topic / Low quality">Off-topic / Low quality</option>
                        </select>
                        <div style="display: flex; justify-content: flex-end; gap: var(--sp-2);">
                            <button type="button" class="btn-ghost" style="font-size: 11px;" onclick="toggleReportForm(@Model.Id)">Cancel</button>
                            <button type="submit" class="btn-warning btn-sm" style="padding: 2px 10px; font-size: 11px; font-weight: 700;">Submit Report</button>
                        </div>
                    </form>
                </div>
            }

            <!-- Inline Reply Form -->
            <div id="reply-form-@Model.Id" class="comment-reply-box" style="display: none; margin-top: var(--sp-2);">
                <form action="@Url.Action("CreateComment", "Posts")" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="postId" value="@Model.PostId" />
                    <input type="hidden" name="parentCommentId" value="@Model.Id" />
                    <textarea name="body" placeholder="Replying to u/@authorName..." required style="min-height: 50px;"></textarea>
                    <div style="display: flex; justify-content: flex-end; gap: var(--sp-2); margin-top: var(--sp-2);">
                        <button type="button" class="btn-ghost" style="font-size: 12px;" onclick="toggleReplyForm(@Model.Id)">Cancel</button>
                        <button type="submit" class="btn-primary" style="padding: 4px 14px; font-size: 12px;">Post Reply</button>
                    </div>
                </form>
            </div>

            <!-- Recursive Child Comments -->
            @if (Model.ChildComments != null && Model.ChildComments.Any())
            {
                <div class="comment-thread" style="margin-top: var(--sp-3); display: flex; flex-direction: column; gap: var(--sp-2);">
                    @foreach (var child in Model.ChildComments.OrderBy(c => c.CreatedAt))
                    {
                        @await Html.PartialAsync("_CommentItem", child)
                    }
                </div>
            }
        </div>
    </div>
</div>

<script>
if (typeof toggleReplyForm !== 'function') {
    function toggleReplyForm(commentId) {
        const form = document.getElementById('reply-form-' + commentId);
        if (form) form.style.display = form.style.display === 'none' ? 'block' : 'none';
    }
}
if (typeof toggleReportForm !== 'function') {
    function toggleReportForm(commentId) {
        const form = document.getElementById('report-comment-form-' + commentId);
        if (form) form.style.display = form.style.display === 'none' ? 'block' : 'none';
    }
}
</script>
