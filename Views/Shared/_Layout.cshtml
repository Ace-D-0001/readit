<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ReadIt</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Header -->
    <header class="app-header d-flex align-items-center justify-content-between px-3 px-md-4">
        <div class="d-flex align-items-center gap-3">
            <button class="btn text-light d-md-none p-0 border-0 fs-4" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar" aria-controls="mobileSidebar">
                <i class="bi bi-list"></i>
            </button>
            <a href="/" class="text-decoration-none fw-bold fs-4 d-flex align-items-center gap-2" style="color: var(--accent);">
                <i class="bi bi-book-half"></i> ReadIt
            </a>
        </div>

        <div class="search-input-group d-none d-sm-flex">
            <i class="bi bi-search" style="color: var(--text-secondary);"></i>
            <input type="text" placeholder="Search subReadIts e.g. CSC440" />
        </div>

        <div class="d-flex align-items-center gap-2">
            <a href="/Account/Login" class="btn-outline">Log In</a>
            <a href="/Account/Register" class="btn-primary">Sign Up</a>
        </div>
    </header>

    <!-- Global App Grid -->
    <div class="app-grid">
        <!-- Left Sidebar -->
        <aside class="app-sidebar">
            <div class="d-flex flex-column gap-2">
                <h6 class="text-uppercase fw-bold px-3 mb-2" style="color: var(--text-secondary); font-size: 11px; letter-spacing: 0.5px;">Your subReadIts</h6>
                
                <a href="/Course/Details/CSC440" class="sidebar-item active">
                    <span class="rounded-circle d-flex align-items-center justify-content-center bg-success text-white fw-bold" style="width: 24px; height: 24px; font-size: 10px;">C</span>
                    <div>
                        <div class="fw-bold" style="font-size: var(--font-size-sm);">CSC440</div>
                        <div style="font-size: 11px; color: var(--text-secondary);">Data Structures</div>
                    </div>
                </a>

                <a href="/Course/Details/CSC183" class="sidebar-item">
                    <span class="rounded-circle d-flex align-items-center justify-content-center bg-primary text-white fw-bold" style="width: 24px; height: 24px; font-size: 10px;">C</span>
                    <div>
                        <div class="fw-bold" style="font-size: var(--font-size-sm);">CSC183</div>
                        <div style="font-size: 11px; color: var(--text-secondary);">Intro to Prog</div>
                    </div>
                </a>

                <a href="/Course/Details/CSC250" class="sidebar-item">
                    <span class="rounded-circle d-flex align-items-center justify-content-center bg-warning text-dark fw-bold" style="width: 24px; height: 24px; font-size: 10px;">C</span>
                    <div>
                        <div class="fw-bold" style="font-size: var(--font-size-sm);">CSC250</div>
                        <div style="font-size: 11px; color: var(--text-secondary);">Discrete Math</div>
                    </div>
                </a>

                <a href="/Course/Details/CSC301" class="sidebar-item">
                    <span class="rounded-circle d-flex align-items-center justify-content-center bg-info text-dark fw-bold" style="width: 24px; height: 24px; font-size: 10px;">C</span>
                    <div>
                        <div class="fw-bold" style="font-size: var(--font-size-sm);">CSC301</div>
                        <div style="font-size: 11px; color: var(--text-secondary);">Software Eng</div>
                    </div>
                </a>

                <hr style="border-color: var(--border-default); margin: 8px 0;" />

                <a href="/Course" class="sidebar-item text-decoration-none" style="color: var(--accent);">
                    <i class="bi bi-compass"></i>
                    <span style="font-size: var(--font-size-sm); font-weight: 600;">+ Explore all subReadIts</span>
                </a>
                
                <a href="/Home/StyleGuide" class="sidebar-item text-decoration-none mt-2" style="color: var(--text-secondary);">
                    <i class="bi bi-palette"></i>
                    <span style="font-size: var(--font-size-sm);">Design StyleGuide</span>
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="app-main">
            @RenderBody()
        </main>

        <!-- Right Aside -->
        <aside class="app-aside">
            <div class="card">
                <h6 class="fw-bold mb-2">About ReadIt</h6>
                <p style="font-size: var(--font-size-sm); color: var(--text-secondary);">
                    ReadIt is a subject-focused community platform for university courses. Access course outlines, notes, playlists, and interact with classmates.
                </p>
                <hr style="border-color: var(--border-default);" />
                <div class="text-center" style="font-size: var(--font-size-sm); color: var(--text-secondary);">
                    Coming soon
                </div>
            </div>
        </aside>
    </div>

    <!-- Offcanvas Mobile Sidebar -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel">
        <div class="offcanvas-header border-bottom border-secondary">
            <h5 class="offcanvas-title" id="mobileSidebarLabel" style="color: var(--accent);"><i class="bi bi-book-half"></i> ReadIt</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <h6 class="text-uppercase fw-bold mb-3" style="color: var(--text-secondary); font-size: 11px;">Your subReadIts</h6>
            <div class="d-flex flex-column gap-2">
                <a href="/Course/Details/CSC440" class="sidebar-item">CSC440 - Data Structures</a>
                <a href="/Course/Details/CSC183" class="sidebar-item">CSC183 - Intro to Prog</a>
                <a href="/Course/Details/CSC250" class="sidebar-item">CSC250 - Discrete Math</a>
                <a href="/Course/Details/CSC301" class="sidebar-item">CSC301 - Software Eng</a>
                <a href="/Course" class="sidebar-item" style="color: var(--accent);">+ Explore all subReadIts</a>
                <a href="/Home/StyleGuide" class="sidebar-item" style="color: var(--text-secondary);">Design StyleGuide</a>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="app-footer text-center">
        <div class="d-flex justify-content-center gap-3 mb-2" style="font-size: var(--font-size-sm);">
            <a href="#" class="text-decoration-none" style="color: var(--text-secondary);">About</a>
            <span>·</span>
            <a href="#" class="text-decoration-none" style="color: var(--text-secondary);">Contact</a>
            <span>·</span>
            <a href="#" class="text-decoration-none" style="color: var(--text-secondary);">Privacy</a>
        </div>
        <div style="font-size: 12px;">&copy; @DateTime.Now.Year ReadIt. All rights reserved.</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
