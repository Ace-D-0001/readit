<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ReadIt</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Read_It.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-dark-card border-bottom border-dark-border sticky-top py-2">
            <div class="container-fluid px-md-4">
                <a class="navbar-brand fw-bold text-accent-custom d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-half fs-4"></i> ReadIt
                </a>
                
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-md-flex justify-content-between align-items-center w-100">
                    <div class="mx-auto w-100 max-w-search mt-2 mt-md-0">
                        <form class="d-flex" role="search" onsubmit="return false;">
                            <div class="input-group search-bar rounded-pill overflow-hidden border border-dark-border">
                                <span class="input-group-text bg-transparent border-0"><i class="bi bi-search text-muted-custom"></i></span>
                                <input type="search" class="form-control border-0 shadow-none bg-transparent text-light-custom" placeholder="Search courses e.g. CSC440" aria-label="Search">
                            </div>
                        </form>
                    </div>

                    <div class="d-flex gap-2 ms-md-3 mt-2 mt-md-0">
                        <a href="/Account/Login" class="btn btn-outline-accent-custom rounded-pill px-4 fw-bold">Log In</a>
                        <a href="/Account/Register" class="btn btn-accent-custom rounded-pill px-4 fw-bold">Sign Up</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-xl my-3">
        <div class="row g-4">
            <!-- Left Sidebar (Navigation & Communities) -->
            <aside class="col-md-3 d-none d-md-block position-sticky" style="top: 70px; height: calc(100vh - 90px); overflow-y: auto;">
                @if (IsSectionDefined("LeftSidebar"))
                {
                    @RenderSection("LeftSidebar")
                }
                else
                {
                    @await Html.PartialAsync("_DefaultLeftSidebar")
                }
            </aside>

            <!-- Middle Content Area (Feed & Main Content) -->
            <main role="main" class="col-12 col-md-9 col-lg-6">
                @RenderBody()
            </main>

            <!-- Right Sidebar Area (Info & Widgets, empty for now as requested) -->
            <aside class="col-lg-3 d-none d-lg-block position-sticky" style="top: 70px; height: calc(100vh - 90px); overflow-y: auto;">
                @if (IsSectionDefined("RightSidebar"))
                {
                    @RenderSection("RightSidebar")
                }
                else
                {
                    <!-- Space left empty for now, to be worked on later -->
                    <div class="text-muted-custom small text-center pt-5">
                        <!-- Space reserved -->
                    </div>
                }
            </aside>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
