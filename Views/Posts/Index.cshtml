@model IEnumerable<Read_It.Models.Post>

@{
    ViewData["Title"] = "All Content & Posts";
    var searchQuery = ViewData["SearchQuery"] as string;
    var selectedFlair = ViewData["SelectedFlair"] as Read_It.Models.PostFlair?;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 m-0" style="color: var(--text-heading); font-weight: 700;">All Content & Discussions</h1>
        <p class="text-secondary mb-0" style="font-size: var(--font-size-sm);">Explore student posts, lecture notes, question banks, and announcements across all courses.</p>
    </div>
</div>

<!-- Filter Bar -->
<div class="card p-3 mb-4">
    <form action="@Url.Action("Index", "Posts")" method="get" class="d-flex flex-wrap gap-2 align-items-center">
        <input type="text" name="search" value="@searchQuery" placeholder="Search posts..." class="form-control bg-transparent text-white border-secondary flex-grow-1" style="max-width: 300px; color: var(--text-primary) !important;" />
        
        <select name="flair" class="form-select bg-dark text-white border-secondary" style="width: 160px; background-color: var(--bg-panel-alt) !important;" onchange="this.form.submit()">
            <option value="">All Flairs</option>
            @foreach (var flair in Enum.GetValues(typeof(Read_It.Models.PostFlair)).Cast<Read_It.Models.PostFlair>())
            {
                <option value="@flair" selected="@(selectedFlair == flair ? "selected" : null)">@flair.ToString()</option>
            }
        </select>

        <button type="submit" class="btn-primary py-1 px-3">Filter</button>
        @if (!string.IsNullOrEmpty(searchQuery) || selectedFlair.HasValue)
        {
            <a href="@Url.Action("Index", "Posts")" class="btn-outline py-1 px-3">Clear Filters</a>
        }
    </form>
</div>

<!-- Posts Feed -->
@if (Model != null && Model.Any())
{
    <div class="d-flex flex-column gap-3">
        @foreach (var post in Model)
        {
            <div class="post-card">
                <div class="d-flex flex-column align-items-center p-3" style="width: 50px; background: var(--bg-panel-alt);">
                    <i class="bi bi-arrow-up-short vote-arrow fs-4"></i>
                    <span class="fw-bold fs-6 my-1">@(post.UpVotes - post.DownVotes)</span>
                    <i class="bi bi-arrow-down-short vote-arrow fs-4"></i>
                </div>
                <div class="p-3 w-100">
                    <div class="d-flex align-items-center gap-2 mb-2" style="font-size: var(--font-size-sm); color: var(--text-secondary);">
                        <a href="@Url.Action("Details", "Courses", new { code = post.Course?.Code })" class="fw-bold text-decoration-none" style="color: var(--accent);">
                            c/@post.Course?.Code
                        </a>
                        <span>•</span>
                        <span>Posted by u/@(post.User?.UserName ?? "student")</span>
                        <span>•</span>
                        <span>@post.CreatedAt.ToString("MMM dd")</span>
                        <span class="flair-badge ms-2">@post.Flair.ToString()</span>
                    </div>

                    <a href="@Url.Action("Details", "Posts", new { id = post.Id })" class="post-title">
                        @post.Title
                    </a>
                    
                    <p class="post-body-preview text-truncate" style="max-width: 750px;">
                        @post.Body
                    </p>

                    <div class="d-flex gap-2 mt-3">
                        <a href="@Url.Action("Details", "Posts", new { id = post.Id })" class="action-btn primary-reply">
                            <i class="bi bi-chat-left-text-fill" style="color: var(--accent);"></i>
                            <span>@(post.Comments?.Count ?? 0) Comments</span>
                        </a>
                        <a href="@Url.Action("Details", "Posts", new { id = post.Id })" class="action-btn">
                            <i class="bi bi-eye"></i> Zoom In / Read Full
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card p-5 text-center text-secondary">
        <h5>No posts found matching your criteria.</h5>
        <p class="mb-0">Try clearing your search filter or selecting a different flair.</p>
    </div>
}
