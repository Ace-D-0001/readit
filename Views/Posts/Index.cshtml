@model IEnumerable<Read_It.Models.Post>

@{
    ViewData["Title"] = "All Content & Posts";
    var searchQuery = ViewData["SearchQuery"] as string;
    var selectedFlair = ViewData["SelectedFlair"] as Read_It.Models.PostFlair?;
    var userVotes = ViewBag.UserVotes as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 m-0" style="color: var(--text-heading); font-weight: 700;">All Content & Discussions</h1>
        <p class="text-secondary mb-0" style="font-size: var(--font-size-sm);">Explore student posts, lecture notes, question banks, and announcements across all courses.</p>
    </div>
</div>

<!-- Filter Bar -->
<div class="card p-3 mb-4">
    <form action="@Url.Action("Index", "Posts")" method="get" class="d-flex flex-wrap gap-2 align-items-center">
        <input type="text" name="search" value="@searchQuery" placeholder="Search posts..." class="form-control bg-transparent text-white border-secondary flex-grow-1" style="max-width: 300px; color: var(--text-primary) !important;" />
        
        <select name="flair" class="form-select bg-dark text-white border-secondary" style="width: 160px; background-color: var(--bg-panel-alt) !important;" onchange="this.form.submit()">
            <option value="">All Flairs</option>
            @foreach (var flair in Enum.GetValues(typeof(Read_It.Models.PostFlair)).Cast<Read_It.Models.PostFlair>())
            {
                <option value="@flair" selected="@(selectedFlair == flair ? "selected" : null)">@flair.ToString()</option>
            }
        </select>

        <button type="submit" class="btn-primary py-1 px-3">Filter</button>
        @if (!string.IsNullOrEmpty(searchQuery) || selectedFlair.HasValue)
        {
            <a href="@Url.Action("Index", "Posts")" class="btn-outline py-1 px-3">Clear Filters</a>
        }
    </form>
</div>

<!-- Posts Feed -->
@if (Model != null && Model.Any())
{
    <div style="display: flex; flex-direction: column; gap: var(--sp-3);">
        @foreach (var post in Model)
        {
            int myVote = userVotes.ContainsKey(post.Id) ? userVotes[post.Id] : 0;
            string authorName = post.User?.UserName ?? "student";
            string flairClass = "flair-" + post.Flair.ToString().ToLower();

            <article class="post-card fade-up" onclick="if (!event.target.closest('a, button, input, form')) window.location.href='@Url.Action("Details", "Posts", new { id = post.Id })';">
                <div class="post-vote-col">
                    <button class="vote-arrow up @(myVote == 1 ? "upvoted" : "")" type="button" title="Upvote" onclick="asyncVote(this, @post.Id, 'post', 1, event)">
                        <i class="bi bi-arrow-up-circle-fill"></i>
                    </button>

                    <span class="vote-count @(myVote == 1 ? "text-accent" : "")">@(post.UpVotes - post.DownVotes)</span>

                    <button class="vote-arrow down @(myVote == -1 ? "downvoted" : "")" type="button" title="Downvote" onclick="asyncVote(this, @post.Id, 'post', -1, event)">
                        <i class="bi bi-arrow-down-circle-fill"></i>
                    </button>
                </div>

                <div class="post-body-col">
                    <div class="post-meta">
                        <span class="avatar avatar-sm" style="background: var(--accent); width: 22px; height: 22px; font-size: 10px;">
                            @authorName.Substring(0, 1).ToUpper()
                        </span>
                        <a href="@Url.Action("Details", "User", new { username = authorName })" style="color: var(--text-heading); font-weight: 700;">
                            u/@authorName
                        </a>
                        <span>·</span>
                        <a href="@Url.Action("Details", "Courses", new { code = post.Course?.Code })" style="color: var(--accent); font-weight: 600;">
                            c/@post.Course?.Code
                        </a>
                        <span class="flair-badge @flairClass">@post.Flair.ToString()</span>
                        <span>·</span>
                        <span>@post.CreatedAt.ToString("MMM dd")</span>
                    </div>

                    <a href="@Url.Action("Details", "Posts", new { id = post.Id })" class="post-title">
                        @post.Title
                    </a>
                    <p class="post-preview">@post.Body</p>

                    <div class="post-actions">
                        <a href="@Url.Action("Details", "Posts", new { id = post.Id })" class="action-btn">
                            <i class="bi bi-chat-left-text-fill" style="color: var(--accent);"></i>
                            @(post.Comments?.Count ?? 0) Comments
                        </a>
                        <a href="@Url.Action("Details", "Posts", new { id = post.Id })" class="action-btn">
                            <i class="bi bi-arrow-right-circle"></i> Read Full
                        </a>
                        <button class="action-btn" style="margin-left: auto;" onclick="navigator.clipboard.writeText(window.location.origin + '/Posts/Details/@post.Id'); alert('Post link copied!');">
                            <i class="bi bi-link-45deg"></i> Copy Link
                        </button>
                    </div>
                </div>
            </article>
        }
    </div>
}
else
{
    <div class="card p-5 text-center text-secondary">
        <h5>No posts found matching your criteria.</h5>
        <p class="mb-0">Try clearing your search filter or selecting a different flair.</p>
    </div>
}
