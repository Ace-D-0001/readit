@model Read_It.Models.Post

@{
    ViewData["Title"] = Model.Title;
    var courseResources = ViewBag.CourseResources as IEnumerable<Read_It.Models.CourseResource> ?? Enumerable.Empty<Read_It.Models.CourseResource>();
    int userPostVote = ViewBag.UserPostVote ?? 0;
    string? currentUserId = ViewBag.CurrentUserId as string;
    bool isAuthor = (!string.IsNullOrEmpty(currentUserId) && currentUserId == Model.UserId);
}

<!-- Breadcrumb / Course context navigation -->
<div style="display: flex; align-items: center; gap: var(--sp-2); margin-bottom: var(--sp-3); font-size: var(--text-sm); color: var(--text-secondary);">
    <a href="/Courses">Courses</a>
    <span>&rsaquo;</span>
    <a href="@Url.Action("Details", "Courses", new { code = Model.Course?.Code })" style="color: var(--accent); font-weight: 600;">
        c/@Model.Course?.Code
    </a>
    <span>&rsaquo;</span>
    <span class="text-truncate" style="max-width: 300px;">@Model.Title</span>
</div>

<!-- Full Zoomed-in Post Card -->
<div class="post-detail-card fade-up">
    <div class="post-detail-header">
        <!-- Upvote / Downvote column -->
        <div class="post-detail-vote-col post-vote-col">
            <button class="vote-arrow up @(userPostVote == 1 ? "upvoted" : "")" title="Upvote" type="button" onclick="asyncVote(this, @Model.Id, 'post', 1, event)">
                <i class="bi bi-arrow-up-circle-fill" style="font-size: 22px;"></i>
            </button>

            <span class="vote-count @(userPostVote == 1 ? "text-accent" : "")" style="font-size: var(--text-md);">@(Model.UpVotes - Model.DownVotes)</span>

            <button class="vote-arrow down @(userPostVote == -1 ? "downvoted" : "")" title="Downvote" type="button" onclick="asyncVote(this, @Model.Id, 'post', -1, event)">
                <i class="bi bi-arrow-down-circle-fill" style="font-size: 22px;"></i>
            </button>
        </div>

        <!-- Post Content Column -->
        <div class="post-detail-body-col">
            <div class="post-meta mb-2">
                <a href="@Url.Action("Details", "Courses", new { code = Model.Course?.Code })">
                    c/@Model.Course?.Code
                </a>
                <span class="flair-badge">@Model.Flair.ToString()</span>
                <span>·</span>
                <span>Posted by <a href="@Url.Action("Details", "User", new { username = Model.User?.UserName })" style="color: var(--text-heading); font-weight: 600;">u/@(Model.User?.UserName ?? "anonymous")</a></span>
                <span>·</span>
                <span>@Model.CreatedAt.ToString("MMM dd, yyyy 'at' hh:mm tt")</span>
            </div>

            <h1 class="post-detail-title">
                @Model.Title
            </h1>

            <div class="post-full-body mb-4">
                @Model.Body
            </div>
        </div>
    </div>

    <div class="post-detail-actions">
        <button class="action-btn active">
            <i class="bi bi-chat-left-text-fill"></i>
            <span>@(Model.Comments?.Count ?? 0) Comments</span>
        </button>

        <button class="action-btn" onclick="navigator.clipboard.writeText(window.location.href); alert('Post link copied!');">
            <i class="bi bi-link-45deg"></i> Copy Link
        </button>

        <button class="action-btn text-muted" onclick="togglePostReportForm()">
            <i class="bi bi-flag"></i> Report Post
        </button>

        @if (isAuthor)
        {
            <a href="@Url.Action("Edit", "Posts", new { id = Model.Id })" class="action-btn" style="color: var(--accent);">
                <i class="bi bi-pencil-square"></i> Edit Post
            </a>
            <form action="@Url.Action("Delete", "Posts", new { id = Model.Id })" method="post" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this post?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="action-btn" style="color: var(--error);">
                    <i class="bi bi-trash-fill"></i> Delete
                </button>
            </form>
        }
    </div>

    <!-- Inline Report Post Form -->
    <div id="report-post-form" class="card p-3 mt-3" style="display: none; border-left: 4px solid var(--warning);">
        <form action="/Posts/ReportPost" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="postId" value="@Model.Id" />
            <h6 style="font-weight: 700; color: var(--warning); margin-bottom: 8px;">Report Post to Admin</h6>
            <div class="mb-2">
                <label class="form-label style-label">Select Reason:</label>
                <select name="reason" class="form-select bg-dark text-white border-secondary" style="font-size: 13px;">
                    <option value="Inappropriate Content">Inappropriate Content</option>
                    <option value="Harassment or Hate Speech">Harassment or Hate Speech</option>
                    <option value="Spam / Misleading Information">Spam / Misleading Information</option>
                    <option value="Academic Misconduct / Cheating">Academic Misconduct / Cheating</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 8px;">
                <button type="button" class="btn-ghost" onclick="togglePostReportForm()">Cancel</button>
                <button type="submit" class="btn-warning py-1 px-3" style="font-size: 12px; font-weight: 700;">Submit Report</button>
            </div>
        </form>
    </div>
</div>

<script>
function togglePostReportForm() {
    const form = document.getElementById('report-post-form');
    if (form) form.style.display = form.style.display === 'none' ? 'block' : 'none';
}
</script>

<!-- Main Comment Form Box -->
<div class="new-comment-box">
    <h6 style="font-weight: 700; color: var(--text-heading); margin-bottom: var(--sp-2);">
        Comment as <span style="color: var(--accent);">u/@(User.Identity?.Name ?? "Guest Student")</span>
    </h6>
    <form action="@Url.Action("CreateComment", "Posts")" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="postId" value="@Model.Id" />
        <textarea name="body" placeholder="What are your thoughts on this subject topic?" required></textarea>
        <div style="display: flex; justify-content: flex-end;">
            <button type="submit" class="btn-primary" style="padding: 8px 22px;">
                <i class="bi bi-chat-fill"></i> Comment
            </button>
        </div>
    </form>
</div>

<!-- Threaded Comments Section -->
<h5 style="font-weight: 800; color: var(--text-heading); margin-bottom: var(--sp-3);">
    Discussion (<span style="color: var(--accent);">@(Model.Comments?.Count ?? 0)</span>)
</h5>

@if (Model.Comments != null && Model.Comments.Any())
{
    var topLevelComments = Model.Comments.Where(c => c.ParentCommentId == null).OrderByDescending(c => c.CreatedAt);
    
    <div style="display: flex; flex-direction: column; gap: var(--sp-3);">
        @foreach (var comment in topLevelComments)
        {
            @await Html.PartialAsync("~/Views/Shared/_CommentItem.cshtml", comment)
        }
    </div>
}
else
{
    <div class="empty-state">
        <i class="bi bi-chat-square-dots" style="font-size: 2rem; display: block; margin-bottom: var(--sp-2);"></i>
        <p>No comments yet. Be the first to start the conversation!</p>
    </div>
}
