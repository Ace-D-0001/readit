@model Read_It.Models.Post

@{
    ViewData["Title"] = "Create Post — ReadIt";
    var courses = ViewBag.Courses as IEnumerable<Read_It.Models.Course> ?? Enumerable.Empty<Read_It.Models.Course>();
    string selectedCourseCode = ViewBag.SelectedCourseCode as string ?? "";
}

<div style="max-width: 740px; margin: 0 auto;">
    <!-- Page Header -->
    <div style="margin-bottom: var(--sp-5);">
        <h1 style="font-size: var(--text-2xl); font-weight: 800; color: var(--text-heading); margin-bottom: var(--sp-1);">
            <i class="bi bi-pencil-square" style="color: var(--accent);"></i> Create a Post
        </h1>
        <p style="color: var(--text-secondary); font-size: var(--text-sm); margin: 0;">
            Share questions, lecture notes, exam prep, or announcements with your IUBAT classmates.
        </p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div style="background: rgba(234, 0, 39, 0.15); border: 1px solid var(--error); color: #ff6b81; border-radius: var(--r-md); padding: var(--sp-3) var(--sp-4); margin-bottom: var(--sp-4); font-size: var(--text-sm);">
            <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.Error
        </div>
    }

    <div class="card p-4">
        <form action="@Url.Action("Create", "Posts")" method="post">
            @Html.AntiForgeryToken()

            <!-- Select Course / SubSubject -->
            <div class="mb-4">
                <label class="form-label fw-bold mb-1" style="color: var(--text-heading); font-size: var(--text-sm);">
                    Select SubSubject / Course <span style="color: var(--accent);">*</span>
                </label>
                <select name="courseId" class="form-control" required style="font-size: var(--text-md);">
                    <option value="">-- Choose SubSubject --</option>
                    @foreach (var c in courses)
                    {
                        <!option value="@c.Id" @(c.Code == selectedCourseCode ? "selected" : "")>
                            c/@c.Code — @c.Title @(c.IsGeneral ? "(General)" : "")
                        </!option>
                    }
                </select>
            </div>

            <!-- Select Flair -->
            <div class="mb-4">
                <label class="form-label fw-bold mb-1" style="color: var(--text-heading); font-size: var(--text-sm);">
                    Flair <span style="color: var(--accent);">*</span>
                </label>
                <div style="display: flex; gap: var(--sp-2); flex-wrap: wrap;">
                    @foreach (Read_It.Models.PostFlair f in Enum.GetValues(typeof(Read_It.Models.PostFlair)))
                    {
                        <label style="cursor: pointer;">
                            <input type="radio" name="flair" value="@f" @(f == Read_It.Models.PostFlair.Question ? "checked" : "") style="display: none;" onchange="updateFlairPills()" />
                            <span class="flair-pill" data-flair="@f"
                                  style="display: inline-block; padding: 6px 14px; border-radius: var(--r-full); font-size: var(--text-xs); font-weight: 700; border: 1.5px solid var(--border-default); background: var(--bg-panel-alt); color: var(--text-secondary); transition: all var(--transition);">
                                @f.ToString()
                            </span>
                        </label>
                    }
                </div>
            </div>

            <!-- Post Title -->
            <div class="mb-4">
                <label class="form-label fw-bold mb-1" style="color: var(--text-heading); font-size: var(--text-sm);">
                    Title <span style="color: var(--accent);">*</span>
                </label>
                <input type="text" name="title" placeholder="Title of your post..." required class="form-control"
                       style="font-size: var(--text-md); font-weight: 600;" maxLength="300" />
            </div>

            <!-- Post Body -->
            <div class="mb-4">
                <label class="form-label fw-bold mb-1" style="color: var(--text-heading); font-size: var(--text-sm);">
                    Content / Body <span style="color: var(--accent);">*</span>
                </label>
                <textarea name="body" placeholder="Write your post content, code snippet, notes, or discussion points here..."
                          required class="form-control" style="min-height: 180px; font-size: var(--text-md); line-height: 1.6;"></textarea>
            </div>

            <!-- Anonymous Post Option (Students only) -->
            @if (!User.IsInRole("Admin"))
            {
                <div class="mb-4 p-3 rounded" style="background: var(--bg-panel-alt); border: 1px solid var(--border-default);">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" name="isAnonymous" value="true" id="anonCheck" style="cursor: pointer;" />
                        <label class="form-check-label fw-bold" for="anonCheck" style="color: var(--text-heading); cursor: pointer; font-size: 13px;">
                            <i class="bi bi-incognito text-warning"></i> Post Anonymously (u/AnonymousStudent)
                        </label>
                    </div>
                    <p class="text-secondary mb-0 mt-1" style="font-size: 11px;">
                        Your identity will be masked from fellow classmates. Ideal for sensitive academic inquiries or asking questions without hesitation.
                    </p>
                </div>
            }

            <!-- Actions -->
            <div style="display: flex; justify-content: flex-end; gap: var(--sp-3); border-top: 1px solid var(--border-default); padding-top: var(--sp-4);">
                <a href="/Posts" class="btn-ghost">Cancel</a>
                <button type="submit" class="btn-primary" style="padding: 9px 24px;">
                    <i class="bi bi-send-fill"></i> Publish Post
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function updateFlairPills() {
    document.querySelectorAll('.flair-pill').forEach(pill => {
        const radio = pill.parentElement.querySelector('input[type="radio"]');
        if (radio.checked) {
            pill.style.background = 'var(--accent-muted)';
            pill.style.borderColor = 'var(--accent)';
            pill.style.color = 'var(--accent)';
        } else {
            pill.style.background = 'var(--bg-panel-alt)';
            pill.style.borderColor = 'var(--border-default)';
            pill.style.color = 'var(--text-secondary)';
        }
    });
}
document.addEventListener('DOMContentLoaded', updateFlairPills);
</script>
