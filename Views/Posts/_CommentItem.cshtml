@model Read_It.Models.Comment

<div class="comment card p-3" id="comment-@Model.Id">
    <div class="d-flex flex-column align-items-center me-2">
        <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold" style="width: 32px; height: 32px; background-color: var(--accent);">
            @(Model.User?.UserName?.Substring(0, 1).ToUpper() ?? "U")
        </div>
    </div>
    <div class="flex-grow-1">
        <div class="comment-meta">
            <span class="comment-author">u/@(Model.User?.UserName ?? "anonymous")</span>
            <span>•</span>
            <span>@Model.CreatedAt.ToString("MMM dd, hh:mm tt")</span>
            @if (Model.UpVotes > 5)
            {
                <span class="comment-badge-top">Top Contributor</span>
            }
        </div>

        <div class="comment-body">
            @Model.Body
        </div>

        <div class="comment-actions">
            <span><i class="bi bi-arrow-up-short"></i> @Model.UpVotes</span>
            <span><i class="bi bi-arrow-down-short"></i></span>
            <span onclick="toggleReplyBox(@Model.Id)"><i class="bi bi-reply-fill"></i> Reply</span>
        </div>

        <!-- Inline Reply Form (hidden by default) -->
        <div id="reply-box-@Model.Id" class="comment-reply-box mt-2" style="display: none;">
            <form action="@Url.Action("CreateComment", "Posts")" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="postId" value="@Model.PostId" />
                <input type="hidden" name="parentCommentId" value="@Model.Id" />
                <textarea name="body" rows="2" placeholder="Write a reply..." required></textarea>
                <div class="d-flex justify-content-end gap-2 mt-2">
                    <button type="button" class="action-btn" onclick="toggleReplyBox(@Model.Id)">Cancel</button>
                    <button type="submit" class="btn-primary py-1 px-3" style="font-size: 12px;">Send Reply</button>
                </div>
            </form>
        </div>

        <!-- Render Nested Child Comments -->
        @if (Model.ChildComments != null && Model.ChildComments.Any())
        {
            <div class="comment-thread">
                @foreach (var child in Model.ChildComments.OrderBy(c => c.CreatedAt))
                {
                    @await Html.PartialAsync("_CommentItem", child)
                }
            </div>
        }
    </div>
</div>

<script>
    if (typeof toggleReplyBox !== 'function') {
        function toggleReplyBox(commentId) {
            const el = document.getElementById('reply-box-' + commentId);
            if (el) {
                el.style.display = el.style.display === 'none' ? 'block' : 'none';
            }
        }
    }
</script>
