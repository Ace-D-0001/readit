@{
    ViewData["Title"] = "Design System Style Guide";
}

<div class="d-flex flex-column gap-4">
    <div class="card">
        <h2 class="fw-bold mb-3" style="color: var(--text-heading);">Design System Style Guide</h2>
        <p style="color: var(--text-secondary);">
            This test page demonstrates the <code>theme.css</code> component classes and design tokens across ReadIt.
        </p>
    </div>

    <!-- Buttons -->
    <div class="card">
        <h5 class="fw-bold mb-3">Buttons (Pill Shape)</h5>
        <div class="d-flex align-items-center gap-3">
            <button class="btn-primary">.btn-primary</button>
            <button class="btn-outline">.btn-outline</button>
        </div>
    </div>

    <!-- Sidebar Items -->
    <div class="card">
        <h5 class="fw-bold mb-3">Sidebar Items</h5>
        <div class="d-flex flex-column gap-2" style="max-width: 300px;">
            <a href="#" class="sidebar-item">
                <i class="bi bi-hash"></i> Default Sidebar Item
            </a>
            <a href="#" class="sidebar-item active">
                <i class="bi bi-check-circle-fill"></i> Active Sidebar Item
            </a>
        </div>
    </div>

    <!-- Vote Arrows -->
    <div class="card">
        <h5 class="fw-bold mb-3">Vote Arrows</h5>
        <div class="d-flex align-items-center gap-4">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-arrow-up-circle-fill vote-arrow"></i>
                <span style="font-size: var(--font-size-sm); color: var(--text-secondary);">Default</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-arrow-up-circle-fill vote-arrow upvoted"></i>
                <span style="font-size: var(--font-size-sm); color: var(--upvote); font-weight: bold;">Upvoted (+1)</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-arrow-down-circle-fill vote-arrow downvoted"></i>
                <span style="font-size: var(--font-size-sm); color: var(--downvote); font-weight: bold;">Downvoted (-1)</span>
            </div>
        </div>
    </div>

    <!-- Flair Badges -->
    <div class="card">
        <h5 class="fw-bold mb-3">Flair Badges</h5>
        <div class="d-flex align-items-center gap-2">
            <span class="flair-badge">Question</span>
            <span class="flair-badge">Notes</span>
            <span class="flair-badge">Discussion</span>
            <span class="flair-badge">Meme</span>
            <span class="flair-badge">Announcement</span>
        </div>
    </div>

    <!-- Sample Card / Post Preview -->
    <div class="card d-flex flex-row p-3">
        <div class="post-vote-box">
            <i class="bi bi-arrow-up-circle-fill vote-arrow upvoted"></i>
            <span class="fw-bold my-1" style="font-size: var(--font-size-sm); color: var(--upvote);">42</span>
            <i class="bi bi-arrow-down-circle-fill vote-arrow"></i>
        </div>
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="flair-badge">Discussion</span>
                <span style="font-size: var(--font-size-sm); color: var(--text-secondary);">Posted in <strong>CSC440</strong> by u/alex • 2 hours ago</span>
            </div>
            <h5 class="fw-bold mb-2" style="color: var(--text-heading);">Sample Card / Post Title Component</h5>
            <p style="color: var(--text-primary); font-size: var(--font-size-md);" class="mb-2">
                This is a demonstration of how a post card looks using the standard <code>.card</code> container, vote arrows, and flair badges.
            </p>
            <div class="d-flex align-items-center gap-3" style="font-size: var(--font-size-sm); color: var(--text-secondary);">
                <span><i class="bi bi-chat-left-text"></i> 14 Comments</span>
                <span><i class="bi bi-share"></i> Share</span>
            </div>
        </div>
    </div>
</div>
