@{
    ViewData["Title"] = "Home Page";
}

<div class="container">
    <!-- Hero Section -->
    <div class="row align-items-center py-5 my-4">
        <div class="col-md-8 mx-auto text-center">
            <h1 class="display-4 fw-bold mb-3">Your course. Your community.</h1>
            <p class="lead text-muted mb-4">Find your subject page, get notes, question banks, and talk to classmates.</p>
            <a href="/Course/Index" class="btn btn-accent btn-lg rounded-pill px-5 fw-bold shadow-sm">Explore Courses</a>
        </div>
    </div>

    <!-- Popular Courses Section -->
    <div class="mt-5">
        <h4 class="fw-bold mb-4">Popular Courses</h4>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            
            <!-- Course Card 1 -->
            <div class="col">
                <div class="card h-100 readit-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold mb-0">CSC440</h5>
                            <span class="badge bg-light text-dark border">1.2k members</span>
                        </div>
                        <h6 class="card-subtitle mb-3 text-muted">Data Structures and Algorithms</h6>
                        <p class="card-text small text-muted">The core algorithms and data structures for computer science.</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3 pt-0">
                        <button class="btn btn-accent rounded-pill w-100 fw-bold">Join</button>
                    </div>
                </div>
            </div>

            <!-- Course Card 2 -->
            <div class="col">
                <div class="card h-100 readit-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold mb-0">CSC183</h5>
                            <span class="badge bg-light text-dark border">850 members</span>
                        </div>
                        <h6 class="card-subtitle mb-3 text-muted">Intro to Programming</h6>
                        <p class="card-text small text-muted">Basics of programming using Python and C++.</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3 pt-0">
                        <button class="btn btn-accent rounded-pill w-100 fw-bold">Join</button>
                    </div>
                </div>
            </div>

            <!-- Course Card 3 -->
            <div class="col">
                <div class="card h-100 readit-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold mb-0">MAT201</h5>
                            <span class="badge bg-light text-dark border">540 members</span>
                        </div>
                        <h6 class="card-subtitle mb-3 text-muted">Calculus II</h6>
                        <p class="card-text small text-muted">Integration, series, and differential equations.</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3 pt-0">
                        <button class="btn btn-accent rounded-pill w-100 fw-bold">Join</button>
                    </div>
                </div>
            </div>

            <!-- Course Card 4 -->
            <div class="col">
                <div class="card h-100 readit-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold mb-0">ENG101</h5>
                            <span class="badge bg-light text-dark border">2.1k members</span>
                        </div>
                        <h6 class="card-subtitle mb-3 text-muted">College Writing</h6>
                        <p class="card-text small text-muted">Academic writing, research, and composition.</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3 pt-0">
                        <button class="btn btn-accent rounded-pill w-100 fw-bold">Join</button>
                    </div>
                </div>
            </div>

            <!-- Course Card 5 -->
            <div class="col">
                <div class="card h-100 readit-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold mb-0">PHY250</h5>
                            <span class="badge bg-light text-dark border">420 members</span>
                        </div>
                        <h6 class="card-subtitle mb-3 text-muted">Physics for Engineers</h6>
                        <p class="card-text small text-muted">Mechanics, thermodynamics, and waves.</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3 pt-0">
                        <button class="btn btn-accent rounded-pill w-100 fw-bold">Join</button>
                    </div>
                </div>
            </div>

            <!-- Course Card 6 -->
            <div class="col">
                <div class="card h-100 readit-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold mb-0">PSY100</h5>
                            <span class="badge bg-light text-dark border">3.4k members</span>
                        </div>
                        <h6 class="card-subtitle mb-3 text-muted">Intro to Psychology</h6>
                        <p class="card-text small text-muted">Human behavior, cognition, and emotion.</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3 pt-0">
                        <button class="btn btn-accent rounded-pill w-100 fw-bold">Join</button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
