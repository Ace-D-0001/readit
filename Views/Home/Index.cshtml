@model IEnumerable<Read_It.Models.Post>

@{
    ViewData["Title"] = "IUBAT ReadIt — Home Feed";
    string activeSort = ViewBag.ActiveSort as string ?? "hot";
    string activeFeed = ViewBag.ActiveFeed as string ?? "all";
    var userVotes = ViewBag.UserVotes as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div style="display: flex; flex-direction: column; gap: var(--sp-4);">

    <!-- Clean Hero Banner -->
    <div class="hero-card fade-up">
        <h2 style="font-size: var(--text-2xl); font-weight: 800; color: var(--text-heading); margin-bottom: var(--sp-2);">
            IUBAT SubSubjects
        </h2>
        <p style="color: var(--text-secondary); font-size: var(--text-md); max-width: 540px; margin: 0 auto var(--sp-4);">
            Select a subReadIt community to view course outlines, question banks, video playlists, and student discussions.
        </p>

        <!-- SubSubject Quick Cards Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--sp-3); margin-bottom: var(--sp-5); text-align: left;">
            <a href="/Courses/Details?code=CSC247" class="card p-3" style="display: flex; align-items: center; gap: var(--sp-3); transition: border-color 0.15s ease;">
                <span class="avatar avatar-sm" style="background: #22c55e; flex-shrink: 0;">C</span>
                <div>
                    <div style="font-size: var(--text-sm); font-weight: 700; color: var(--text-heading);">CSC247</div>
                    <div style="font-size: var(--text-xs); color: var(--text-secondary);">Computer Architecture</div>
                </div>
            </a>
            <a href="/Courses/Details?code=CSC391" class="card p-3" style="display: flex; align-items: center; gap: var(--sp-3); transition: border-color 0.15s ease;">
                <span class="avatar avatar-sm" style="background: #3b82f6; flex-shrink: 0;">C</span>
                <div>
                    <div style="font-size: var(--text-sm); font-weight: 700; color: var(--text-heading);">CSC391</div>
                    <div style="font-size: var(--text-xs); color: var(--text-secondary);">Data Structures</div>
                </div>
            </a>
            <a href="/Courses/Details?code=CSC433" class="card p-3" style="display: flex; align-items: center; gap: var(--sp-3); transition: border-color 0.15s ease;">
                <span class="avatar avatar-sm" style="background: #a855f7; flex-shrink: 0;">C</span>
                <div>
                    <div style="font-size: var(--text-sm); font-weight: 700; color: var(--text-heading);">CSC433</div>
                    <div style="font-size: var(--text-xs); color: var(--text-secondary);">Database Systems</div>
                </div>
            </a>
            <a href="/Courses/Details?code=MAT247" class="card p-3" style="display: flex; align-items: center; gap: var(--sp-3); transition: border-color 0.15s ease;">
                <span class="avatar avatar-sm" style="background: #0ea5e9; flex-shrink: 0;">M</span>
                <div>
                    <div style="font-size: var(--text-sm); font-weight: 700; color: var(--text-heading);">MAT247</div>
                    <div style="font-size: var(--text-xs); color: var(--text-secondary);">Numerical Analysis</div>
                </div>
            </a>
        </div>

        <div class="hero-btns">
            <a href="/Courses"      class="btn-primary">Explore All SubReadIts</a>
            <a href="/Posts/Create" class="btn-outline"><i class="bi bi-pencil-square"></i> Create Post</a>
        </div>
    </div>

    <!-- Feed Scope & Sorting Tabs -->
    <div class="card p-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <!-- Feed Scope -->
            <div class="dept-tabs mb-0">
                <a href="/?feed=all&sort=@activeSort" class="dept-tab @(activeFeed == "all" ? "active" : "")">
                    <i class="bi bi-globe"></i> All University Feed
                </a>
                @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin"))
                {
                    <a href="/?feed=my&sort=@activeSort" class="dept-tab @(activeFeed == "my" ? "active" : "")">
                        <i class="bi bi-bookmark-star-fill text-warning"></i> My Enrolled Subjects
                    </a>
                }
            </div>

            <!-- Sorting Tabs -->
            <div class="dept-tabs mb-0" style="font-size: 12px;">
                <a href="/?feed=@activeFeed&sort=hot" class="dept-tab @(activeSort == "hot" ? "active" : "")">
                    <i class="bi bi-fire"></i> Hot
                </a>
                <a href="/?feed=@activeFeed&sort=top" class="dept-tab @(activeSort == "top" ? "active" : "")">
                    <i class="bi bi-star"></i> Top
                </a>
                <a href="/?feed=@activeFeed&sort=new" class="dept-tab @(activeSort == "new" ? "active" : "")">
                    <i class="bi bi-sparkles"></i> New
                </a>
            </div>
        </div>
    </div>

    <!-- Posts Feed -->
    @if (Model != null && Model.Any())
    {
        @foreach (var post in Model)
        {
            int myVote = userVotes.ContainsKey(post.Id) ? userVotes[post.Id] : 0;
            bool isAdmin = User.IsInRole("Admin");
            string authorName = post.IsAnonymous && !isAdmin ? "AnonymousStudent" : (post.User?.UserName ?? "student");
            string flairClass = "flair-" + post.Flair.ToString().ToLower();

            <article class="post-card fade-up" onclick="if (!event.target.closest('a, button, input, form')) window.location.href='@Url.Action("Details", "Posts", new { id = post.Id })';">
                <!-- Integrated Vote Column -->
                <div class="post-vote-col">
                    @if (!isAdmin)
                    {
                        <button class="vote-arrow up @(myVote == 1 ? "upvoted" : "")" title="Upvote" type="button" onclick="asyncVote(this, @post.Id, 'post', 1, event)">
                            <i class="bi bi-arrow-up-circle-fill"></i>
                        </button>

                        <span class="vote-count @(myVote == 1 ? "text-accent" : "")">@(post.UpVotes - post.DownVotes)</span>

                        <button class="vote-arrow down @(myVote == -1 ? "downvoted" : "")" title="Downvote" type="button" onclick="asyncVote(this, @post.Id, 'post', -1, event)">
                            <i class="bi bi-arrow-down-circle-fill"></i>
                        </button>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark font-weight-bold" style="font-size: 9px; writing-mode: vertical-rl; transform: rotate(180deg); padding: 4px 2px;">
                            MOD
                        </span>
                        <span class="vote-count text-muted mt-1" style="font-size: 10px;">@(post.UpVotes - post.DownVotes)</span>
                    }
                </div>

                <!-- Body Column -->
                <div class="post-body-col">
                    <div class="post-meta flex-wrap">
                        <span class="avatar avatar-sm" style="background: @(authorName == "admin" ? "var(--warning)" : (post.IsAnonymous ? "#64748b" : "var(--accent)")); color: @(authorName == "admin" ? "#000" : "#fff"); font-weight: 800; width: 22px; height: 22px; font-size: 10px;">
                            @authorName.Substring(0, 1).ToUpper()
                        </span>
                        <a href="@Url.Action("Details", "User", new { username = (post.IsAnonymous && !isAdmin ? null : authorName) })" style="color: var(--text-heading); font-weight: 700;">
                            u/@authorName
                        </a>
                        @if (post.IsAnonymous && isAdmin)
                        {
                            <span class="badge bg-secondary" style="font-size: 9px;">Anon (u/@post.User?.UserName)</span>
                        }
                        @if (authorName == "admin")
                        {
                            <span class="badge bg-warning text-dark font-weight-bold" style="font-size: 9px; padding: 1px 4px;">ADMIN</span>
                        }
                        <span>·</span>
                        <a href="@Url.Action("Details", "Courses", new { code = post.Course?.Code })" style="color: var(--accent); font-weight: 600;">
                            c/@post.Course?.Code
                        </a>
                        <span class="flair-badge @flairClass">@post.Flair.ToString()</span>
                        @if (post.IsPinned)
                        {
                            <span class="badge bg-warning text-dark font-weight-bold" style="font-size: 10px;"><i class="bi bi-pin-angle-fill"></i> Pinned</span>
                        }
                        @if (post.IsLocked)
                        {
                            <span class="badge bg-danger" style="font-size: 10px;"><i class="bi bi-lock-fill"></i> Locked</span>
                        }
                        @if (post.AcceptedCommentId.HasValue)
                        {
                            <span class="badge bg-success" style="font-size: 10px;"><i class="bi bi-check-circle-fill"></i> Solved</span>
                        }
                        <span>·</span>
                        <span>@post.CreatedAt.ToString("MMM dd")</span>
                    </div>

                    <a href="@Url.Action("Details", "Posts", new { id = post.Id })" class="post-title">
                        @post.Title
                    </a>

                    <p class="post-preview">@post.Body</p>

                    <div class="post-actions flex-wrap">
                        <a href="@Url.Action("Details", "Posts", new { id = post.Id })" class="action-btn">
                            <i class="bi bi-chat-left-text-fill" style="color: var(--accent);"></i>
                            @(post.Comments?.Count ?? 0) Comments
                        </a>
                        <a href="@Url.Action("Details", "Posts", new { id = post.Id })" class="action-btn">
                            <i class="bi bi-arrow-right-circle"></i> Read Full
                        </a>
                        <button class="action-btn" style="margin-left: auto;" onclick="navigator.clipboard.writeText(window.location.origin + '/Posts/Details/@post.Id'); alert('Post link copied!');">
                            <i class="bi bi-link-45deg"></i> Copy Link
                        </button>
                    </div>
                </div>
            </article>
        }
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-journal-x" style="font-size: 2.5rem; color: var(--text-muted); display: block; margin-bottom: var(--sp-3);"></i>
            <h5>No posts found in this feed</h5>
            @if (activeFeed == "my")
            {
                <p>You haven't followed any subsubjects yet, or there are no posts in your followed subjects. <a href="/Courses" style="color: var(--accent);">Explore all subjects</a> to follow some!</p>
            }
            else
            {
                <p><a href="/Posts/Create" style="color: var(--accent);">Create the first post</a> to get the conversation started!</p>
            }
        </div>
    }
</div>
