@{
    ViewData["Title"] = "Home";
}

<!-- Hero Banner (Reddit announcement style) -->
<div class="card bg-dark-card border-dark-border mb-4">
    <div class="card-body p-4 text-center">
        <h2 class="fw-bold text-accent-custom mb-2">Your course. Your community.</h2>
        <p class="text-muted-custom mb-3">Find your subject page, get lecture notes, past papers, and discuss with fellow students.</p>
        <a href="/Course/Index" class="btn btn-accent-custom rounded-pill px-4 fw-bold">Explore All Courses</a>
    </div>
</div>

<!-- Home Feed Sub-header -->
<div class="d-flex align-items-center justify-content-between mb-3 px-1">
    <h5 class="fw-bold m-0 text-light-custom">Trending Courses</h5>
    <div class="dropdown">
        <button class="btn btn-outline-accent-custom btn-sm rounded-pill dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-fire"></i> Hot
        </button>
        <ul class="dropdown-menu dropdown-menu-dark">
            <li><a class="dropdown-item" href="#">Hot</a></li>
            <li><a class="dropdown-item" href="#">New</a></li>
            <li><a class="dropdown-item" href="#">Top</a></li>
        </ul>
    </div>
</div>

<!-- Course Cards Grid -->
<div class="row row-cols-1 g-3">
    <!-- Course 1 -->
    <div class="col">
        <div class="card readit-card overflow-hidden">
            <div class="d-flex">
                <div class="vote-col">
                    <button class="vote-btn up"><i class="bi bi-arrow-up-circle-fill"></i></button>
                    <span class="vote-score text-muted-custom">1.2k</span>
                    <button class="vote-btn down"><i class="bi bi-arrow-down-circle-fill"></i></button>
                </div>
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 small">CSC440</span>
                        <small class="text-muted-custom">Posted by System • 3 hours ago</small>
                    </div>
                    <h5 class="card-title fw-bold text-light-custom mb-2">
                        <a href="/Course/Details/csc440" class="text-decoration-none text-light-custom hover-light">
                            CSC440: Data Structures and Algorithms
                        </a>
                    </h5>
                    <p class="card-text text-muted-custom small mb-3">
                        The ultimate hub for Csc440. Access notes, lecture playlists, standard books, and discuss assignments.
                    </p>
                    <div class="d-flex gap-3 small text-muted-custom">
                        <span><i class="bi bi-people-fill text-accent-custom"></i> 1,240 Members</span>
                        <span><i class="bi bi-chat-right-text"></i> 84 Discussions</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Course 2 -->
    <div class="col">
        <div class="card readit-card overflow-hidden">
            <div class="d-flex">
                <div class="vote-col">
                    <button class="vote-btn up"><i class="bi bi-arrow-up-circle-fill"></i></button>
                    <span class="vote-score text-muted-custom">850</span>
                    <button class="vote-btn down"><i class="bi bi-arrow-down-circle-fill"></i></button>
                </div>
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-50 small">CSC183</span>
                        <small class="text-muted-custom">Posted by System • 5 hours ago</small>
                    </div>
                    <h5 class="card-title fw-bold text-light-custom mb-2">
                        <a href="/Course/Details/csc183" class="text-decoration-none text-light-custom hover-light">
                            CSC183: Introduction to Programming
                        </a>
                    </h5>
                    <p class="card-text text-muted-custom small mb-3">
                        Welcome to Python and C++ basics. Ideal for beginners starting their coding journey.
                    </p>
                    <div class="d-flex gap-3 small text-muted-custom">
                        <span><i class="bi bi-people-fill text-accent-custom"></i> 850 Members</span>
                        <span><i class="bi bi-chat-right-text"></i> 43 Discussions</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Course 3 -->
    <div class="col">
        <div class="card readit-card overflow-hidden">
            <div class="d-flex">
                <div class="vote-col">
                    <button class="vote-btn up"><i class="bi bi-arrow-up-circle-fill"></i></button>
                    <span class="vote-score text-muted-custom">540</span>
                    <button class="vote-btn down"><i class="bi bi-arrow-down-circle-fill"></i></button>
                </div>
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50 small">MAT201</span>
                        <small class="text-muted-custom">Posted by System • 1 day ago</small>
                    </div>
                    <h5 class="card-title fw-bold text-light-custom mb-2">
                        <a href="/Course/Details/mat201" class="text-decoration-none text-light-custom hover-light">
                            MAT201: Calculus II
                        </a>
                    </h5>
                    <p class="card-text text-muted-custom small mb-3">
                        Discuss integrations, limits, sequences, series, and advanced calculus methods.
                    </p>
                    <div class="d-flex gap-3 small text-muted-custom">
                        <span><i class="bi bi-people-fill text-accent-custom"></i> 540 Members</span>
                        <span><i class="bi bi-chat-right-text"></i> 12 Discussions</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
