@{
    ViewData["Title"] = "Home Feed";
}

<div class="d-flex flex-column gap-3">
    <!-- Hero / Welcome Card -->
    <div class="card p-4 text-center">
        <h2 class="fw-bold mb-2" style="color: var(--text-heading);">Your course. Your community.</h2>
        <p style="color: var(--text-secondary);" class="mb-3">Find your subject page, get notes, question banks, and talk to classmates.</p>
        <div>
            <a href="/Course" class="btn-primary">Explore All Courses</a>
        </div>
    </div>

    <!-- Feed Filter Header -->
    <div class="d-flex align-items-center justify-content-between px-1">
        <h6 class="fw-bold m-0 text-uppercase" style="color: var(--text-secondary); font-size: 12px; letter-spacing: 0.5px;">Popular Posts</h6>
        <div class="d-flex gap-2">
            <button class="btn-outline py-1 px-3" style="font-size: var(--font-size-sm);"><i class="bi bi-fire"></i> Hot</button>
            <button class="btn-outline py-1 px-3" style="font-size: var(--font-size-sm);"><i class="bi bi-stars"></i> New</button>
        </div>
    </div>

    <!-- Dummy Post 1 -->
    <div class="card d-flex flex-row p-3">
        <div class="post-vote-box">
            <i class="bi bi-arrow-up-circle-fill vote-arrow upvoted"></i>
            <span class="fw-bold my-1" style="font-size: var(--font-size-sm); color: var(--upvote);">128</span>
            <i class="bi bi-arrow-down-circle-fill vote-arrow"></i>
        </div>
        <div class="flex-grow-1">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="flair-badge">Notes</span>
                <span style="font-size: var(--font-size-sm); color: var(--text-secondary);">
                    Posted in <a href="/Course/Details/CSC440" class="fw-bold text-decoration-none" style="color: var(--text-primary);">r/CSC440</a> by u/prof_smith • 3h ago
                </span>
            </div>
            <h5 class="fw-bold mb-2" style="color: var(--text-heading);">
                <a href="/Post/1" class="text-decoration-none" style="color: var(--text-heading);">Complete Midterm Review Sheet & Practice Problems (Spring 2026)</a>
            </h5>
            <p style="color: var(--text-primary); font-size: var(--font-size-md);" class="mb-2">
                Hey everyone! I compiled all the lecture notes on B-Trees, AVL Trees, and Graph Traversal algorithms into a single PDF. Check out the link attached.
            </p>
            <div class="d-flex align-items-center gap-3" style="font-size: var(--font-size-sm); color: var(--text-secondary);">
                <a href="/Post/1" class="text-decoration-none" style="color: var(--text-secondary);"><i class="bi bi-chat-left-text"></i> 34 Comments</a>
                <span><i class="bi bi-share"></i> Share</span>
            </div>
        </div>
    </div>

    <!-- Dummy Post 2 -->
    <div class="card d-flex flex-row p-3">
        <div class="post-vote-box">
            <i class="bi bi-arrow-up-circle-fill vote-arrow"></i>
            <span class="fw-bold my-1" style="font-size: var(--font-size-sm); color: var(--text-secondary);">64</span>
            <i class="bi bi-arrow-down-circle-fill vote-arrow"></i>
        </div>
        <div class="flex-grow-1">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="flair-badge">Question</span>
                <span style="font-size: var(--font-size-sm); color: var(--text-secondary);">
                    Posted in <a href="/Course/Details/CSC183" class="fw-bold text-decoration-none" style="color: var(--text-primary);">r/CSC183</a> by u/coder_newbie • 5h ago
                </span>
            </div>
            <h5 class="fw-bold mb-2" style="color: var(--text-heading);">
                <a href="/Post/2" class="text-decoration-none" style="color: var(--text-heading);">Difference between list comprehension and map() in Python?</a>
            </h5>
            <p style="color: var(--text-primary); font-size: var(--font-size-md);" class="mb-2">
                I'm solving assignment 2 and wondering when to prefer list comprehension over map(). Which one is considered more Pythonic?
            </p>
            <div class="d-flex align-items-center gap-3" style="font-size: var(--font-size-sm); color: var(--text-secondary);">
                <a href="/Post/2" class="text-decoration-none" style="color: var(--text-secondary);"><i class="bi bi-chat-left-text"></i> 18 Comments</a>
                <span><i class="bi bi-share"></i> Share</span>
            </div>
        </div>
    </div>

    <!-- Dummy Post 3 -->
    <div class="card d-flex flex-row p-3">
        <div class="post-vote-box">
            <i class="bi bi-arrow-up-circle-fill vote-arrow"></i>
            <span class="fw-bold my-1" style="font-size: var(--font-size-sm); color: var(--text-secondary);">95</span>
            <i class="bi bi-arrow-down-circle-fill vote-arrow"></i>
        </div>
        <div class="flex-grow-1">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="flair-badge">Discussion</span>
                <span style="font-size: var(--font-size-sm); color: var(--text-secondary);">
                    Posted in <a href="/Course/Details/CSC250" class="fw-bold text-decoration-none" style="color: var(--text-primary);">r/CSC250</a> by u/math_geek • 1d ago
                </span>
            </div>
            <h5 class="fw-bold mb-2" style="color: var(--text-heading);">
                <a href="/Post/3" class="text-decoration-none" style="color: var(--text-heading);">Study Group forming for Discrete Mathematics Final Exam</a>
            </h5>
            <p style="color: var(--text-primary); font-size: var(--font-size-md);" class="mb-2">
                We meet every Tuesday at 5 PM in the CS Lab. Reply if interested or send a DM!
            </p>
            <div class="d-flex align-items-center gap-3" style="font-size: var(--font-size-sm); color: var(--text-secondary);">
                <a href="/Post/3" class="text-decoration-none" style="color: var(--text-secondary);"><i class="bi bi-chat-left-text"></i> 12 Comments</a>
                <span><i class="bi bi-share"></i> Share</span>
            </div>
        </div>
    </div>
</div>
