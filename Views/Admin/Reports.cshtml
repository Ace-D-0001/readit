@model IEnumerable<Read_It.Models.Report>

@{
    ViewData["Title"] = "Content Reports Moderation — Admin";
    var selectedStatus = ViewBag.SelectedStatus as Read_It.Models.ReportStatus?;
}

<div style="display: flex; flex-direction: column; gap: var(--sp-4);" class="fade-up">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between">
        <div>
            <h1 class="h3 m-0" style="color: var(--text-heading); font-weight: 800;">🚨 Post & Comment Reports</h1>
            <p class="text-secondary mb-0" style="font-size: var(--text-sm);">Review student user flags, see report reasons, approve/reject reports, delete content, or ban users.</p>
        </div>
        <a href="/Admin" class="btn-outline py-1 px-3" style="font-size: 12px;">&larr; Back to Dashboard</a>
    </div>

    <!-- Status Filter Tabs -->
    <div class="dept-tabs mb-0">
        <a href="/Admin/Reports" class="dept-tab @(!selectedStatus.HasValue ? "active" : "")">All Reports</a>
        <a href="/Admin/Reports?status=Pending" class="dept-tab @(selectedStatus == Read_It.Models.ReportStatus.Pending ? "active" : "")">
            Pending <span class="badge bg-warning text-dark ms-1">Action Needed</span>
        </a>
        <a href="/Admin/Reports?status=Approved" class="dept-tab @(selectedStatus == Read_It.Models.ReportStatus.Approved ? "active" : "")">Approved / Action Taken</a>
        <a href="/Admin/Reports?status=Rejected" class="dept-tab @(selectedStatus == Read_It.Models.ReportStatus.Rejected ? "active" : "")">Rejected Reports</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success p-2" style="font-size: 12px;">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Reports Table -->
    @if (Model != null && Model.Any())
    {
        <div class="card p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle" style="font-size: 13px;">
                    <thead style="background: var(--bg-panel-alt); font-size: 11px; text-transform: uppercase; color: var(--text-muted);">
                        <tr>
                            <th style="padding: 12px 16px;">Target</th>
                            <th>Report Reason</th>
                            <th>Reported By</th>
                            <th>Content Preview & Author</th>
                            <th>Status</th>
                            <th style="text-align: right; padding-right: 16px;">Admin Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rep in Model)
                        {
                            string targetAuthor = rep.Post?.User?.UserName ?? rep.Comment?.User?.UserName ?? "unknown";
                            string targetSnippet = rep.Post?.Title ?? rep.Comment?.Body ?? "(Content Deleted)";

                            <tr>
                                <td style="padding: 12px 16px;">
                                    @if (rep.TargetType == Read_It.Models.ReportTargetType.Post)
                                    {
                                        <span class="badge bg-primary"><i class="bi bi-file-text-fill"></i> Post</span>
                                        @if (rep.PostId != null)
                                        {
                                            <a href="/Posts/Details/@rep.PostId" target="_blank" style="color: var(--accent); font-size: 11px; display: block; margin-top: 2px;">View Post #@rep.PostId</a>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark"><i class="bi bi-chat-dots-fill"></i> Comment</span>
                                    }
                                </td>
                                <td>
                                    <strong style="color: var(--warning);">"@rep.Reason"</strong>
                                    <div style="font-size: 10px; color: var(--text-muted);">@rep.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                                </td>
                                <td>
                                    <span style="font-weight: 600;">u/@(rep.ReportedByUser?.UserName ?? "student")</span>
                                </td>
                                <td style="max-width: 260px;">
                                    <div class="text-truncate" style="font-weight: 600; color: var(--text-heading);">@targetSnippet</div>
                                    <div style="font-size: 11px; color: var(--text-secondary);">Author: <strong>u/@targetAuthor</strong></div>
                                </td>
                                <td>
                                    @if (rep.Status == Read_It.Models.ReportStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else if (rep.Status == Read_It.Models.ReportStatus.Approved)
                                    {
                                        <span class="badge bg-success">Approved / Action Taken</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Rejected</span>
                                    }
                                </td>
                                <td style="text-align: right; padding-right: 16px;">
                                    @if (rep.Status == Read_It.Models.ReportStatus.Pending)
                                    {
                                        <div class="dropdown d-inline-block">
                                            <button class="btn btn-sm btn-outline-light dropdown-toggle py-1 px-2" type="button" data-bs-toggle="dropdown" style="font-size: 11px;">
                                                Take Action
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow" style="font-size: 12px;">
                                                <li>
                                                    <form action="/Admin/ResolveReport" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="reportId" value="@rep.Id" />
                                                        <input type="hidden" name="actionType" value="approve" />
                                                        <button type="submit" class="dropdown-item text-success"><i class="bi bi-check-circle"></i> Approve Report (Acknowledge)</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form action="/Admin/ResolveReport" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="reportId" value="@rep.Id" />
                                                        <input type="hidden" name="actionType" value="delete_content" />
                                                        <button type="submit" class="dropdown-item text-danger" onclick="return confirm('Delete this reported content?');"><i class="bi bi-trash-fill"></i> Approve & Delete Content</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form action="/Admin/ResolveReport" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="reportId" value="@rep.Id" />
                                                        <input type="hidden" name="actionType" value="ban_user" />
                                                        <button type="submit" class="dropdown-item text-warning" onclick="return confirm('Ban author u/@targetAuthor?');"><i class="bi bi-person-x-fill"></i> Approve & Ban User (u/@targetAuthor)</button>
                                                    </form>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <form action="/Admin/ResolveReport" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="reportId" value="@rep.Id" />
                                                        <input type="hidden" name="actionType" value="reject" />
                                                        <button type="submit" class="dropdown-item text-secondary"><i class="bi bi-x-circle"></i> Reject Report (Dismiss)</button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    }
                                    else
                                    {
                                        <span style="font-size: 11px; color: var(--text-muted);">Resolved</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card p-5 text-center text-secondary">
            <h5>No reports found matching status filter.</h5>
        </div>
    }
</div>
