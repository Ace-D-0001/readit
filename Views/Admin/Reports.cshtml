@model IEnumerable<Read_It.Models.Report>

@{
    ViewData["Title"] = "Content Moderation & Reports — Admin";
    var selectedStatus = ViewBag.SelectedStatus as Read_It.Models.ReportStatus?;
    string? selectedTarget = ViewBag.SelectedTarget as string;
}

<div style="display: flex; flex-direction: column; gap: var(--sp-4);" class="fade-up">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h1 class="h3 m-0" style="color: var(--text-heading); font-weight: 800;">
                <i class="bi bi-shield-shaded text-danger"></i> Community Content Reports
            </h1>
            <p class="text-secondary mb-0" style="font-size: var(--text-sm);">
                Investigate flagged posts and comments, enforce community guidelines, remove violations, and ban repeat offenders.
            </p>
        </div>
        <div style="display: flex; gap: 8px;">
            <a href="/Admin" class="btn-outline py-1 px-3" style="font-size: 12px;">&larr; Cockpit Dashboard</a>
        </div>
    </div>

    <!-- Status & Target Filter Bar -->
    <div class="card p-3">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
            <!-- Status Tabs -->
            <div class="dept-tabs mb-0">
                <a href="/Admin/Reports@(selectedTarget != null ? "?target=" + selectedTarget : "")" class="dept-tab @(!selectedStatus.HasValue ? "active" : "")">
                    All Reports
                </a>
                <a href="/Admin/Reports?status=Pending@(selectedTarget != null ? "&target=" + selectedTarget : "")" class="dept-tab @(selectedStatus == Read_It.Models.ReportStatus.Pending ? "active" : "")">
                    Pending Review <span class="badge bg-danger ms-1">Action Needed</span>
                </a>
                <a href="/Admin/Reports?status=Approved@(selectedTarget != null ? "&target=" + selectedTarget : "")" class="dept-tab @(selectedStatus == Read_It.Models.ReportStatus.Approved ? "active" : "")">
                    Action Taken
                </a>
                <a href="/Admin/Reports?status=Rejected@(selectedTarget != null ? "&target=" + selectedTarget : "")" class="dept-tab @(selectedStatus == Read_It.Models.ReportStatus.Rejected ? "active" : "")">
                    Dismissed
                </a>
            </div>

            <!-- Target Type Filter -->
            <div style="display: flex; gap: 6px; font-size: 12px;">
                <a href="/Admin/Reports@(selectedStatus.HasValue ? "?status=" + selectedStatus.Value : "")" class="btn btn-sm @(string.IsNullOrEmpty(selectedTarget) ? "btn-secondary" : "btn-outline-secondary") py-1 px-2">
                    All Types
                </a>
                <a href="/Admin/Reports?target=post@(selectedStatus.HasValue ? "&status=" + selectedStatus.Value : "")" class="btn btn-sm @(selectedTarget == "post" ? "btn-primary" : "btn-outline-primary") py-1 px-2">
                    Posts Only
                </a>
                <a href="/Admin/Reports?target=comment@(selectedStatus.HasValue ? "&status=" + selectedStatus.Value : "")" class="btn btn-sm @(selectedTarget == "comment" ? "btn-info" : "btn-outline-info") py-1 px-2">
                    Comments Only
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 p-3" style="font-size: 13px;">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    <!-- Reports Table -->
    @if (Model != null && Model.Any())
    {
        <div class="card p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle" style="font-size: 13px;">
                    <thead style="background: var(--bg-panel-alt); font-size: 11px; text-transform: uppercase; color: var(--text-muted);">
                        <tr>
                            <th style="padding: 12px 16px;">Target</th>
                            <th>Report Reason & Date</th>
                            <th>Reported By</th>
                            <th>Flagged Content & Author</th>
                            <th>Status</th>
                            <th style="text-align: right; padding-right: 16px;">Moderation Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rep in Model)
                        {
                            string targetAuthor = rep.Post?.User?.UserName ?? rep.Comment?.User?.UserName ?? "unknown";
                            string targetSnippet = rep.Post?.Title ?? rep.Comment?.Body ?? "(Content deleted or removed)";

                            <tr>
                                <td style="padding: 12px 16px;">
                                    @if (rep.TargetType == Read_It.Models.ReportTargetType.Post)
                                    {
                                        <span class="badge bg-primary"><i class="bi bi-file-text-fill"></i> Post</span>
                                        @if (rep.PostId != null)
                                        {
                                            <a href="/Posts/Details/@rep.PostId" target="_blank" style="color: var(--accent); font-size: 11px; display: block; margin-top: 2px;">
                                                View Post #@rep.PostId &nearr;
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark"><i class="bi bi-chat-dots-fill"></i> Comment</span>
                                        @if (rep.Comment != null)
                                        {
                                            <a href="/Posts/Details/@rep.Comment.PostId" target="_blank" style="color: var(--accent); font-size: 11px; display: block; margin-top: 2px;">
                                                On Post #@rep.Comment.PostId &nearr;
                                            </a>
                                        }
                                    }
                                </td>
                                <td>
                                    <strong style="color: var(--warning); font-size: 13px;">"@rep.Reason"</strong>
                                    <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
                                        <i class="bi bi-clock"></i> @rep.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                    </div>
                                </td>
                                <td>
                                    <span style="font-weight: 600; color: var(--text-heading);">
                                        u/@(rep.ReportedByUser?.UserName ?? "student")
                                    </span>
                                </td>
                                <td style="max-width: 280px;">
                                    <div class="text-truncate" style="font-weight: 600; color: var(--text-heading);" title="@targetSnippet">
                                        @targetSnippet
                                    </div>
                                    <div style="font-size: 11px; color: var(--text-secondary); margin-top: 2px;">
                                        Author: <strong class="text-white">u/@targetAuthor</strong>
                                    </div>
                                </td>
                                <td>
                                    @if (rep.Status == Read_It.Models.ReportStatus.Pending)
                                    {
                                        <span class="badge bg-danger">Pending</span>
                                    }
                                    else if (rep.Status == Read_It.Models.ReportStatus.Approved)
                                    {
                                        <span class="badge bg-success">Action Taken</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Dismissed</span>
                                    }
                                </td>
                                <td style="text-align: right; padding-right: 16px;">
                                    @if (rep.Status == Read_It.Models.ReportStatus.Pending)
                                    {
                                        <div style="display: inline-flex; gap: 6px;">
                                            <form action="/Admin/ResolveReport" method="post" style="margin: 0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="reportId" value="@rep.Id" />
                                                <input type="hidden" name="actionType" value="delete_content" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 11px;" title="Delete the reported content" onclick="return confirm('Delete this reported content?');">
                                                    <i class="bi bi-trash-fill"></i> Delete
                                                </button>
                                            </form>

                                            <form action="/Admin/ResolveReport" method="post" style="margin: 0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="reportId" value="@rep.Id" />
                                                <input type="hidden" name="actionType" value="ban_user" />
                                                <button type="submit" class="btn btn-sm btn-outline-warning py-1 px-2" style="font-size: 11px;" title="Ban offending author and delete content" onclick="return confirm('Ban author u/@targetAuthor and remove their content?');">
                                                    <i class="bi bi-person-x-fill"></i> Ban Author
                                                </button>
                                            </form>

                                            <form action="/Admin/ResolveReport" method="post" style="margin: 0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="reportId" value="@rep.Id" />
                                                <input type="hidden" name="actionType" value="reject" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary py-1 px-2" style="font-size: 11px;" title="Dismiss report as invalid">
                                                    Dismiss
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span style="font-size: 11px; color: var(--text-muted);"><i class="bi bi-check-all"></i> Resolved</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card p-5 text-center text-secondary">
            <i class="bi bi-shield-check text-success fs-1 mb-3"></i>
            <h5>No reports match the current filters.</h5>
            <p style="font-size: 13px;">Community content is healthy and moderated.</p>
        </div>
    }
</div>
