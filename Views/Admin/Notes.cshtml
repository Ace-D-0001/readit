@model IEnumerable<Read_It.Models.CourseResource>

@{
    ViewData["Title"] = "Student Notes Verification — Admin";
    var selectedStatus = ViewBag.SelectedStatus as Read_It.Models.ResourceStatus?;
    string? searchQuery = ViewBag.SearchQuery as string;
}

<div style="display: flex; flex-direction: column; gap: var(--sp-4);" class="fade-up">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h1 class="h3 m-0" style="color: var(--text-heading); font-weight: 800;">
                <i class="bi bi-file-earmark-check-fill text-warning"></i> Student Notes Verification Hub
            </h1>
            <p class="text-secondary mb-0" style="font-size: var(--text-sm);">
                Review student-uploaded lecture notes and study guides before making them publicly discoverable.
            </p>
        </div>
        <a href="/Admin" class="btn-outline py-1 px-3" style="font-size: 12px;">&larr; Cockpit Dashboard</a>
    </div>

    <!-- Filter & Search Bar -->
    <div class="card p-3">
        <form action="/Admin/Notes" method="get" class="d-flex flex-wrap gap-3 align-items-center justify-content-between">
            <!-- Status Tabs -->
            <div class="dept-tabs mb-0">
                <a href="/Admin/Notes@(searchQuery != null ? "?search=" + searchQuery : "")" class="dept-tab @(!selectedStatus.HasValue ? "active" : "")">
                    All Notes
                </a>
                <a href="/Admin/Notes?status=Pending@(searchQuery != null ? "&search=" + searchQuery : "")" class="dept-tab @(selectedStatus == Read_It.Models.ResourceStatus.Pending ? "active" : "")">
                    Pending Review <span class="badge bg-warning text-dark ms-1">Review</span>
                </a>
                <a href="/Admin/Notes?status=Approved@(searchQuery != null ? "&search=" + searchQuery : "")" class="dept-tab @(selectedStatus == Read_It.Models.ResourceStatus.Approved ? "active" : "")">
                    Approved (Public)
                </a>
                <a href="/Admin/Notes?status=Rejected@(searchQuery != null ? "&search=" + searchQuery : "")" class="dept-tab @(selectedStatus == Read_It.Models.ResourceStatus.Rejected ? "active" : "")">
                    Rejected
                </a>
            </div>

            <!-- Search Form -->
            <div class="d-flex gap-2">
                @if (selectedStatus.HasValue)
                {
                    <input type="hidden" name="status" value="@selectedStatus.Value" />
                }
                <input type="text" name="search" value="@searchQuery" placeholder="Search by title or code..." class="form-control form-control-sm bg-transparent text-white border-secondary" style="width: 220px;" />
                <button type="submit" class="btn-primary py-1 px-3" style="font-size: 12px;">Search</button>
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <a href="/Admin/Notes@(selectedStatus.HasValue ? "?status=" + selectedStatus.Value : "")" class="btn-outline py-1 px-2" style="font-size: 12px;">Clear</a>
                }
            </div>
        </form>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 p-3" style="font-size: 13px;">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    <!-- Notes Table -->
    @if (Model != null && Model.Any())
    {
        <div class="card p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle" style="font-size: 13px;">
                    <thead style="background: var(--bg-panel-alt); font-size: 11px; text-transform: uppercase; color: var(--text-muted);">
                        <tr>
                            <th style="padding: 12px 16px;">Subject</th>
                            <th>Note Title & Details</th>
                            <th>Uploaded By</th>
                            <th>Document Preview</th>
                            <th>Status</th>
                            <th style="text-align: right; padding-right: 16px;">Verification Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var note in Model)
                        {
                            <tr>
                                <td style="padding: 12px 16px;">
                                    <a href="/Courses/Details?code=@(note.Course?.Code)" target="_blank" class="badge bg-primary text-decoration-none" style="font-size: 12px;">
                                        c/@(note.Course?.Code ?? "General") &nearr;
                                    </a>
                                </td>
                                <td>
                                    <strong style="color: var(--text-heading); font-size: 14px;">@note.Title</strong>
                                    @if (!string.IsNullOrEmpty(note.Description))
                                    {
                                        <div style="font-size: 12px; color: var(--text-secondary); margin-top: 2px;">@note.Description</div>
                                    }
                                    <div style="font-size: 10px; color: var(--text-muted); margin-top: 2px;">
                                        <i class="bi bi-clock"></i> Uploaded: @note.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                    </div>
                                </td>
                                <td>
                                    <span style="font-weight: 600; color: var(--text-heading);">u/@(note.UploadedByUser?.UserName ?? "student")</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(note.FilePath))
                                    {
                                        <a href="@note.FilePath" target="_blank" class="btn btn-sm btn-outline-info py-1 px-2" style="font-size: 11px;">
                                            <i class="bi bi-file-earmark-pdf-fill"></i> View Document &nearr;
                                        </a>
                                    }
                                    else if (!string.IsNullOrEmpty(note.Url))
                                    {
                                        <a href="@note.Url" target="_blank" class="btn btn-sm btn-outline-light py-1 px-2" style="font-size: 11px;">
                                            <i class="bi bi-box-arrow-up-right"></i> Open Link &nearr;
                                        </a>
                                    }
                                </td>
                                <td>
                                    @if (note.Status == Read_It.Models.ResourceStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-clock-history"></i> Pending Review</span>
                                    }
                                    else if (note.Status == Read_It.Models.ResourceStatus.Approved)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Approved (Public)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger" title="Reason: @note.RejectionReason"><i class="bi bi-x-circle-fill"></i> Rejected</span>
                                    }
                                </td>
                                <td style="text-align: right; padding-right: 16px;">
                                    @if (note.Status == Read_It.Models.ResourceStatus.Pending)
                                    {
                                        <div style="display: flex; gap: 6px; justify-content: flex-end;">
                                            <form action="/Admin/ApproveNote" method="post" style="margin: 0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="noteId" value="@note.Id" />
                                                <button type="submit" class="btn btn-sm btn-success py-1 px-3" style="font-size: 11px; font-weight: 700;">
                                                    <i class="bi bi-check-lg"></i> Approve
                                                </button>
                                            </form>

                                            <button class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 11px;" onclick="toggleRejectModal(@note.Id)">
                                                <i class="bi bi-x-lg"></i> Reject
                                            </button>
                                        </div>

                                        <!-- Reject Modal Form Inline -->
                                        <div id="reject-modal-@note.Id" style="display: none; margin-top: 8px; text-align: left; background: var(--bg-panel-alt); padding: 10px; border-radius: var(--r-sm);">
                                            <form action="/Admin/RejectNote" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="noteId" value="@note.Id" />
                                                <label class="form-label style-label" style="font-size: 10px;">Rejection Feedback:</label>
                                                <input type="text" name="rejectionReason" class="form-control form-control-sm mb-2" placeholder="e.g. Low resolution / incomplete notes" style="font-size: 11px;" />
                                                <div style="display: flex; gap: 6px;">
                                                    <button type="submit" class="btn btn-sm btn-danger py-1 px-2" style="font-size: 11px;">Confirm Reject</button>
                                                    <button type="button" class="btn btn-sm btn-ghost py-1 px-2" style="font-size: 11px;" onclick="toggleRejectModal(@note.Id)">Cancel</button>
                                                </div>
                                            </form>
                                        </div>
                                    }
                                    else if (note.Status == Read_It.Models.ResourceStatus.Rejected)
                                    {
                                        <form action="/Admin/ApproveNote" method="post" style="display: inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="noteId" value="@note.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success py-1 px-2" style="font-size: 11px;">Re-Approve</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span style="font-size: 11px; color: var(--text-muted);"><i class="bi bi-globe"></i> Publicly Visible</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card p-5 text-center text-secondary">
            <i class="bi bi-journal-check text-success fs-1 mb-3"></i>
            <h5>No notes match the current search or status filter.</h5>
        </div>
    }
</div>

<script>
function toggleRejectModal(id) {
    const el = document.getElementById('reject-modal-' + id);
    if (el) el.style.display = el.style.display === 'none' ? 'block' : 'none';
}
</script>
