@model IEnumerable<Read_It.Models.CourseResource>

@{
    ViewData["Title"] = "Student Notes Approval System — Admin";
    var selectedStatus = ViewBag.SelectedStatus as Read_It.Models.ResourceStatus?;
}

<div style="display: flex; flex-direction: column; gap: var(--sp-4);" class="fade-up">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between">
        <div>
            <h1 class="h3 m-0" style="color: var(--text-heading); font-weight: 800;">📝 Student Uploaded Notes Approval</h1>
            <p class="text-secondary mb-0" style="font-size: var(--text-sm);">Student uploaded notes are held in pending status until approved by an admin before becoming publicly visible.</p>
        </div>
        <a href="/Admin" class="btn-outline py-1 px-3" style="font-size: 12px;">&larr; Back to Dashboard</a>
    </div>

    <!-- Status Tabs -->
    <div class="dept-tabs mb-0">
        <a href="/Admin/Notes" class="dept-tab @(!selectedStatus.HasValue ? "active" : "")">All Notes</a>
        <a href="/Admin/Notes?status=Pending" class="dept-tab @(selectedStatus == Read_It.Models.ResourceStatus.Pending ? "active" : "")">
            Pending Approval <span class="badge bg-warning text-dark ms-1">Review</span>
        </a>
        <a href="/Admin/Notes?status=Approved" class="dept-tab @(selectedStatus == Read_It.Models.ResourceStatus.Approved ? "active" : "")">Approved Notes</a>
        <a href="/Admin/Notes?status=Rejected" class="dept-tab @(selectedStatus == Read_It.Models.ResourceStatus.Rejected ? "active" : "")">Rejected Notes</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success p-2" style="font-size: 12px;">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Notes Table -->
    @if (Model != null && Model.Any())
    {
        <div class="card p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle" style="font-size: 13px;">
                    <thead style="background: var(--bg-panel-alt); font-size: 11px; text-transform: uppercase; color: var(--text-muted);">
                        <tr>
                            <th style="padding: 12px 16px;">Subject</th>
                            <th>Note Title & Description</th>
                            <th>Uploaded By</th>
                            <th>File / URL Link</th>
                            <th>Status</th>
                            <th style="text-align: right; padding-right: 16px;">Approval Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var note in Model)
                        {
                            <tr>
                                <td style="padding: 12px 16px;">
                                    <span class="badge bg-primary" style="font-size: 11px;">c/@(note.Course?.Code ?? "General")</span>
                                </td>
                                <td>
                                    <strong style="color: var(--text-heading); font-size: 14px;">@note.Title</strong>
                                    @if (!string.IsNullOrEmpty(note.Description))
                                    {
                                        <div style="font-size: 12px; color: var(--text-secondary); margin-top: 2px;">@note.Description</div>
                                    }
                                    <div style="font-size: 10px; color: var(--text-muted); margin-top: 2px;">Uploaded: @note.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                                </td>
                                <td>
                                    <span style="font-weight: 600;">u/@(note.UploadedByUser?.UserName ?? "student")</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(note.FilePath))
                                    {
                                        <a href="@note.FilePath" target="_blank" class="btn btn-sm btn-outline-info py-1 px-2" style="font-size: 11px;">
                                            <i class="bi bi-file-earmark-pdf-fill"></i> Download PDF/File
                                        </a>
                                    }
                                    else if (!string.IsNullOrEmpty(note.Url))
                                    {
                                        <a href="@note.Url" target="_blank" class="btn btn-sm btn-outline-light py-1 px-2" style="font-size: 11px;">
                                            <i class="bi bi-box-arrow-up-right"></i> Open Link
                                        </a>
                                    }
                                </td>
                                <td>
                                    @if (note.Status == Read_It.Models.ResourceStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-clock-history"></i> Pending</span>
                                    }
                                    else if (note.Status == Read_It.Models.ResourceStatus.Approved)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Approved (Public)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger" title="Reason: @note.RejectionReason"><i class="bi bi-x-circle-fill"></i> Rejected</span>
                                    }
                                </td>
                                <td style="text-align: right; padding-right: 16px;">
                                    @if (note.Status == Read_It.Models.ResourceStatus.Pending)
                                    {
                                        <div style="display: flex; gap: 6px; justify-content: flex-end;">
                                            <form action="/Admin/ApproveNote" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="noteId" value="@note.Id" />
                                                <button type="submit" class="btn btn-sm btn-success py-1 px-3" style="font-size: 12px; font-weight: 700;">
                                                    <i class="bi bi-check-lg"></i> Approve Note
                                                </button>
                                            </form>

                                            <button class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 12px;" onclick="toggleRejectModal(@note.Id)">
                                                <i class="bi bi-x-lg"></i> Reject
                                            </button>
                                        </div>

                                        <!-- Reject Modal Form Inline -->
                                        <div id="reject-modal-@note.Id" style="display: none; margin-top: 8px; text-align: left; background: var(--bg-panel-alt); padding: 10px; border-radius: var(--r-sm);">
                                            <form action="/Admin/RejectNote" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="noteId" value="@note.Id" />
                                                <label class="form-label style-label" style="font-size: 10px;">Rejection Reason (Optional):</label>
                                                <input type="text" name="rejectionReason" class="form-control form-control-sm mb-2" placeholder="e.g. Incomplete notes / corrupt PDF file" style="font-size: 11px;" />
                                                <div style="display: flex; gap: 6px;">
                                                    <button type="submit" class="btn btn-sm btn-danger py-1 px-2" style="font-size: 11px;">Confirm Reject</button>
                                                    <button type="button" class="btn btn-sm btn-ghost py-1 px-2" style="font-size: 11px;" onclick="toggleRejectModal(@note.Id)">Cancel</button>
                                                </div>
                                            </form>
                                        </div>
                                    }
                                    else if (note.Status == Read_It.Models.ResourceStatus.Rejected)
                                    {
                                        <form action="/Admin/ApproveNote" method="post" style="display: inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="noteId" value="@note.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success py-1 px-2" style="font-size: 11px;">Re-Approve</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span style="font-size: 11px; color: var(--text-muted);">Visible on subpage</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card p-5 text-center text-secondary">
            <h5>No notes found matching status filter.</h5>
        </div>
    }
</div>

<script>
function toggleRejectModal(id) {
    const el = document.getElementById('reject-modal-' + id);
    if (el) el.style.display = el.style.display === 'none' ? 'block' : 'none';
}
</script>
