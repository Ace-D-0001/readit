@model IEnumerable<Read_It.Models.ApplicationUser>

@{
    ViewData["Title"] = "User Accounts & Moderation — Admin";
    var userRoles = ViewBag.UserRoles as Dictionary<string, string> ?? new Dictionary<string, string>();
    string? searchQuery = ViewBag.SearchQuery as string;
    string? selectedStatus = ViewBag.SelectedStatus as string;
    string? selectedRole = ViewBag.SelectedRole as string;
}

<div style="display: flex; flex-direction: column; gap: var(--sp-4);" class="fade-up">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h1 class="h3 m-0" style="color: var(--text-heading); font-weight: 800;">
                <i class="bi bi-people-fill text-primary"></i> User Directory & Access Control
            </h1>
            <p class="text-secondary mb-0" style="font-size: var(--text-sm);">
                Search registered student and faculty accounts, view role assignments, and enforce bans for guideline violations.
            </p>
        </div>
        <a href="/Admin" class="btn-outline py-1 px-3" style="font-size: 12px;">&larr; Cockpit Dashboard</a>
    </div>

    <!-- Filter & Search Bar -->
    <div class="card p-3">
        <form action="/Admin/Users" method="get" class="d-flex flex-wrap gap-3 align-items-center justify-content-between">
            <!-- Status Tabs -->
            <div class="dept-tabs mb-0">
                <a href="/Admin/Users@(searchQuery != null ? "?search=" + searchQuery : "")" class="dept-tab @(string.IsNullOrEmpty(selectedStatus) ? "active" : "")">
                    All Accounts
                </a>
                <a href="/Admin/Users?status=active@(searchQuery != null ? "&search=" + searchQuery : "")" class="dept-tab @(selectedStatus == "active" ? "active" : "")">
                    Active
                </a>
                <a href="/Admin/Users?status=banned@(searchQuery != null ? "&search=" + searchQuery : "")" class="dept-tab @(selectedStatus == "banned" ? "active" : "")">
                    Banned Roster <span class="badge bg-danger ms-1">Restricted</span>
                </a>
            </div>

            <!-- Search Form -->
            <div class="d-flex gap-2">
                @if (!string.IsNullOrEmpty(selectedStatus))
                {
                    <input type="hidden" name="status" value="@selectedStatus" />
                }
                <input type="text" name="search" value="@searchQuery" placeholder="Search by name or email..." class="form-control form-control-sm bg-transparent text-white border-secondary" style="width: 220px;" />
                <button type="submit" class="btn-primary py-1 px-3" style="font-size: 12px;">Search</button>
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <a href="/Admin/Users@(string.IsNullOrEmpty(selectedStatus) ? "" : "?status=" + selectedStatus)" class="btn-outline py-1 px-2" style="font-size: 12px;">Clear</a>
                }
            </div>
        </form>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 p-3" style="font-size: 13px;">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 p-3" style="font-size: 13px;">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
        </div>
    }

    <!-- Users Table -->
    <div class="card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle" style="font-size: 13px;">
                <thead style="background: var(--bg-panel-alt); font-size: 11px; text-transform: uppercase; color: var(--text-muted);">
                    <tr>
                        <th style="padding: 12px 16px;">User Profile</th>
                        <th>Institutional Email</th>
                        <th>System Role</th>
                        <th>Bio / Profile Snippet</th>
                        <th>Account Status</th>
                        <th style="text-align: right; padding-right: 16px;">Moderation Control</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        string role = userRoles.ContainsKey(user.Id) ? userRoles[user.Id] : "Student";

                        <tr>
                            <td style="padding: 12px 16px;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span class="avatar avatar-sm" style="background: @(role == "Admin" ? "var(--warning)" : "var(--accent)"); font-size: 10px; color: @(role == "Admin" ? "#000" : "#fff"); font-weight: 800;">
                                        @(user.UserName?.Substring(0, 1).ToUpper() ?? "U")
                                    </span>
                                    <div>
                                        <strong style="color: var(--text-heading); font-size: 13px;">u/@user.UserName</strong>
                                        <div style="font-size: 10px; color: var(--text-muted);">
                                            <i class="bi bi-calendar"></i> Joined @user.CreatedAt.ToString("MMM yyyy")
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <code>@user.Email</code>
                            </td>
                            <td>
                                @if (role == "Admin")
                                {
                                    <span class="badge bg-warning text-dark font-weight-bold">
                                        <i class="bi bi-shield-lock-fill"></i> Admin
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-light">Student</span>
                                }
                            </td>
                            <td style="max-width: 220px;" class="text-truncate">
                                <span style="color: var(--text-secondary); font-size: 12px;">@(string.IsNullOrEmpty(user.Bio) ? "No bio provided" : user.Bio)</span>
                            </td>
                            <td>
                                @if (user.IsBanned)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-slash-circle-fill"></i> Banned</span>
                                }
                                else
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Active</span>
                                }
                            </td>
                            <td style="text-align: right; padding-right: 16px;">
                                @if (user.UserName != "admin")
                                {
                                    <div class="d-flex justify-content-end gap-2 flex-wrap">
                                        <!-- Issue Warning Button -->
                                        <button class="btn btn-sm btn-outline-warning py-1 px-2" style="font-size: 11px; font-weight: 600;" onclick="toggleWarnModal('@user.Id')">
                                            <i class="bi bi-exclamation-triangle-fill"></i> Warn
                                        </button>

                                        @if (user.IsBanned)
                                        {
                                            <form action="/Admin/ToggleBanUser" method="post" style="display: inline; margin: 0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-success py-1 px-2" style="font-size: 11px; font-weight: 600;">
                                                    <i class="bi bi-person-check-fill"></i> Unban
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 11px; font-weight: 600;" onclick="toggleBanReasonModal('@user.Id')">
                                                <i class="bi bi-person-x-fill"></i> Ban
                                            </button>
                                        }
                                    </div>

                                    <!-- Inline Warn Form Modal -->
                                    <div id="warn-modal-@user.Id" style="display: none; margin-top: 8px; text-align: left; background: var(--bg-panel-alt); padding: 10px; border-radius: var(--r-sm); border-left: 3px solid var(--warning);">
                                        <form action="/Admin/WarnUser" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <label class="form-label" style="font-size: 10px; color: var(--warning); font-weight: 700;">Issue Formal Warning to u/@user.UserName:</label>
                                            <input type="text" name="reason" required class="form-control form-control-sm mb-2" placeholder="e.g. Inappropriate language in discussion thread" style="font-size: 11px;" />
                                            <div style="display: flex; gap: 6px;">
                                                <button type="submit" class="btn btn-sm btn-warning py-1 px-2 text-dark font-weight-bold" style="font-size: 11px;">Send Warning</button>
                                                <button type="button" class="btn btn-sm btn-ghost py-1 px-2" style="font-size: 11px;" onclick="toggleWarnModal('@user.Id')">Cancel</button>
                                            </div>
                                        </form>
                                    </div>

                                    <!-- Inline Ban Form Modal -->
                                    <div id="ban-modal-@user.Id" style="display: none; margin-top: 8px; text-align: left; background: var(--bg-panel-alt); padding: 10px; border-radius: var(--r-sm); border-left: 3px solid #ef4444;">
                                        <form action="/Admin/ToggleBanUser" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <label class="form-label" style="font-size: 10px; color: var(--error); font-weight: 700;">Ban Reason (logged in profile):</label>
                                            <input type="text" name="reason" class="form-control form-control-sm mb-2" placeholder="e.g. Harassment / Repeated spamming" style="font-size: 11px;" />
                                            <div style="display: flex; gap: 6px;">
                                                <button type="submit" class="btn btn-sm btn-danger py-1 px-2" style="font-size: 11px;">Confirm Ban</button>
                                                <button type="button" class="btn btn-sm btn-ghost py-1 px-2" style="font-size: 11px;" onclick="toggleBanReasonModal('@user.Id')">Cancel</button>
                                            </div>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span style="font-size: 11px; color: var(--text-muted);"><i class="bi bi-shield-check text-warning"></i> Primary Admin</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
function toggleBanReasonModal(userId) {
    const el = document.getElementById('ban-modal-' + userId);
    if (el) el.style.display = el.style.display === 'none' ? 'block' : 'none';
}

function toggleWarnModal(userId) {
    const el = document.getElementById('warn-modal-' + userId);
    if (el) el.style.display = el.style.display === 'none' ? 'block' : 'none';
}
</script>
