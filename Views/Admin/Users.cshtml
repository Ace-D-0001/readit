@model IEnumerable<Read_It.Models.ApplicationUser>

@{
    ViewData["Title"] = "User Account Management & Ban List — Admin";
    var userRoles = ViewBag.UserRoles as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<div style="display: flex; flex-direction: column; gap: var(--sp-4);" class="fade-up">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between">
        <div>
            <h1 class="h3 m-0" style="color: var(--text-heading); font-weight: 800;">👥 User Accounts & Ban Management</h1>
            <p class="text-secondary mb-0" style="font-size: var(--text-sm);">View registered accounts, verify assigned roles, and ban or unban users responsible for inappropriate behavior.</p>
        </div>
        <a href="/Admin" class="btn-outline py-1 px-3" style="font-size: 12px;">&larr; Back to Dashboard</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success p-2" style="font-size: 12px;">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger p-2" style="font-size: 12px;">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Users Table -->
    <div class="card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle" style="font-size: 13px;">
                <thead style="background: var(--bg-panel-alt); font-size: 11px; text-transform: uppercase; color: var(--text-muted);">
                    <tr>
                        <th style="padding: 12px 16px;">User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Bio / Details</th>
                        <th>Account Status</th>
                        <th style="text-align: right; padding-right: 16px;">Ban / Unban Control</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        string role = userRoles.ContainsKey(user.Id) ? userRoles[user.Id] : "Student";

                        <tr>
                            <td style="padding: 12px 16px;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span class="avatar avatar-sm" style="background: var(--accent); font-size: 10px;">
                                        @(user.UserName?.Substring(0, 1).ToUpper() ?? "U")
                                    </span>
                                    <div>
                                        <strong style="color: var(--text-heading);">u/@user.UserName</strong>
                                        <div style="font-size: 10px; color: var(--text-muted);">Joined @user.CreatedAt.ToString("MMM yyyy")</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <code>@user.Email</code>
                            </td>
                            <td>
                                @if (role == "Admin")
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-shield-lock-fill"></i> Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark">Student</span>
                                }
                            </td>
                            <td style="max-width: 220px;" class="text-truncate">
                                <span style="color: var(--text-secondary); font-size: 12px;">@(string.IsNullOrEmpty(user.Bio) ? "No bio provided" : user.Bio)</span>
                            </td>
                            <td>
                                @if (user.IsBanned)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-person-x-fill"></i> Banned</span>
                                }
                                else
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Active</span>
                                }
                            </td>
                            <td style="text-align: right; padding-right: 16px;">
                                @if (user.UserName != "admin")
                                {
                                    <form action="/Admin/ToggleBanUser" method="post" style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        @if (user.IsBanned)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success py-1 px-3" style="font-size: 11px;">
                                                <i class="bi bi-person-check-fill"></i> Unban User
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-3" style="font-size: 11px;" onclick="return confirm('Are you sure you want to BAN u/@user.UserName?');">
                                                <i class="bi bi-person-x-fill"></i> Ban User
                                            </button>
                                        }
                                    </form>
                                }
                                else
                                {
                                    <span style="font-size: 11px; color: var(--text-muted);">Protected</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
