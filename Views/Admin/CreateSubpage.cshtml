@{
    ViewData["Title"] = "Create Subpage — Admin";
    var depts = ViewBag.Departments as IEnumerable<Read_It.Models.Department> ?? Enumerable.Empty<Read_It.Models.Department>();
}

<div style="max-width: 580px; margin: 20px auto;" class="fade-up">
    <div class="card p-4 shadow-lg">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h3 style="font-weight: 800; color: var(--text-heading); margin: 0;">Create New Subject Subpage</h3>
            <a href="/Admin/Subpages" class="btn-ghost" style="font-size: 12px;">&larr; Cancel</a>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger p-2 mb-3" style="font-size: var(--text-xs); border-radius: var(--r-sm);">
                @Html.ValidationSummary(false, "", new { @class = "mb-0" })
            </div>
        }

        <form action="/Admin/CreateSubpage" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label style-label">Subject Code (e.g. CSC440, CSC183, MAT257)</label>
                <input type="text" name="code" class="form-control" placeholder="CSC440" required style="font-weight: 700; text-transform: uppercase;" />
            </div>

            <div class="mb-3">
                <label class="form-label style-label">Subject Title / Name</label>
                <input type="text" name="title" class="form-control" placeholder="e.g. Software Engineering & System Design" required />
            </div>

            <div class="mb-3">
                <label class="form-label style-label">Description / Syllabus Overview</label>
                <textarea name="description" class="form-control" rows="3" placeholder="Overview of the course topics, objectives, and prerequisites..."></textarea>
            </div>

            <div class="mb-3 form-check">
                <input type="checkbox" name="isGeneral" value="true" class="form-check-input" id="isGeneralCheck" />
                <label class="form-check-label text-light" for="isGeneralCheck" style="font-size: 13px;">
                    General Course (Visible across all IUBAT departments)
                </label>
            </div>

            <div class="mb-4">
                <label class="form-label style-label">Associated Departments (If not general)</label>
                <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                    @foreach (var d in depts)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="departmentIds" value="@d.Id" id="dept-@d.Id" />
                            <label class="form-check-label text-secondary" for="dept-@d.Id" style="font-size: 12px;">
                                @d.Name (@d.Abbreviation)
                            </label>
                        </div>
                    }
                </div>
            </div>

            <button type="submit" class="btn-primary w-100 py-2">Create Subpage</button>
        </form>
    </div>
</div>
