@model IEnumerable<Read_It.Models.Course>

@{
    ViewData["Title"] = "Subpage Catalog & Management — Admin";
    string? searchQuery = ViewBag.SearchQuery as string;
}

<div style="display: flex; flex-direction: column; gap: var(--sp-4);" class="fade-up">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h1 class="h3 m-0" style="color: var(--text-heading); font-weight: 800;">
                <i class="bi bi-journal-album text-success"></i> Subpage & Course Management
            </h1>
            <p class="text-secondary mb-0" style="font-size: var(--text-sm);">
                Create and configure subject subpages, modify course descriptions, attach syllabus links, or remove discontinued courses.
            </p>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <a href="/Admin/CreateSubpage" class="btn-primary py-1 px-3" style="font-size: 13px;">
                <i class="bi bi-plus-circle-fill"></i> New Subpage
            </a>
            <a href="/Admin" class="btn-outline py-1 px-3" style="font-size: 12px;">&larr; Cockpit</a>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="card p-3">
        <form action="/Admin/Subpages" method="get" class="d-flex gap-2">
            <input type="text" name="search" value="@searchQuery" placeholder="Search by course code or title (e.g. CSC391)..." class="form-control form-control-sm bg-transparent text-white border-secondary" style="max-width: 320px;" />
            <button type="submit" class="btn-primary py-1 px-3" style="font-size: 12px;">Search</button>
            @if (!string.IsNullOrEmpty(searchQuery))
            {
                <a href="/Admin/Subpages" class="btn-outline py-1 px-2" style="font-size: 12px;">Clear</a>
            }
        </form>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 p-3" style="font-size: 13px;">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    <!-- Subpages Grid -->
    @if (Model != null && Model.Any())
    {
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--sp-3);">
            @foreach (var course in Model)
            {
                <div class="card p-3" style="display: flex; flex-direction: column; justify-content: space-between; border-top: 3px solid var(--accent); background: var(--bg-panel);">
                    <div>
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
                            <div>
                                <span class="badge bg-success" style="font-size: 12px; font-weight: 800;">c/@course.Code</span>
                                @if (course.IsGeneral)
                                {
                                    <span class="badge bg-secondary ms-1">General</span>
                                }
                                else
                                {
                                    @foreach (var cd in course.CourseDepartments)
                                    {
                                        <span class="badge bg-dark border text-light ms-1">@cd.Department?.Abbreviation</span>
                                    }
                                }
                            </div>
                            <a href="/Courses/Details?code=@course.Code" target="_blank" style="font-size: 11px; color: var(--accent); font-weight: 600;">
                                View Subpage &nearr;
                            </a>
                        </div>

                        <h5 style="font-weight: 800; color: var(--text-heading); margin-bottom: 4px;">@course.Title</h5>
                        <p style="color: var(--text-secondary); font-size: 12px; height: 38px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; margin-bottom: 12px; line-height: 1.4;">
                            @(string.IsNullOrEmpty(course.Description) ? "No description provided for this subpage." : course.Description)
                        </p>

                        <div style="display: flex; gap: 12px; font-size: 11px; color: var(--text-muted); margin-bottom: 16px;">
                            <span><i class="bi bi-file-earmark-text text-warning"></i> @course.Resources.Count Notes & Links</span>
                            <span><i class="bi bi-chat-left-text text-primary"></i> @course.Posts.Count Posts</span>
                        </div>
                    </div>

                    <div style="display: flex; gap: 8px; border-top: 1px solid var(--border-default); padding-top: 10px;">
                        <a href="/Admin/EditSubpage/@course.Id" class="btn btn-sm btn-outline-info py-1 px-3" style="flex: 1; font-size: 12px; font-weight: 600;">
                            <i class="bi bi-pencil-square"></i> Edit Details
                        </a>
                        <a href="/Admin/CreateAnnouncement?courseCode=@course.Code" class="btn btn-sm btn-outline-warning py-1 px-2" style="font-size: 12px;" title="Post Announcement to this Subpage">
                            <i class="bi bi-megaphone-fill"></i>
                        </a>

                        <form action="/Admin/DeleteSubpage" method="post" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete subpage c/@course.Code and all associated content?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@course.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 12px;" title="Delete Subpage">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card p-5 text-center text-secondary">
            <i class="bi bi-journal-x fs-1 mb-3"></i>
            <h5>No subpages found matching search.</h5>
        </div>
    }
</div>
