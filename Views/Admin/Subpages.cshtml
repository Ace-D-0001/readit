@model IEnumerable<Read_It.Models.Course>

@{
    ViewData["Title"] = "Subpage Management — Admin";
}

<div style="display: flex; flex-direction: column; gap: var(--sp-4);" class="fade-up">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between">
        <div>
            <h1 class="h3 m-0" style="color: var(--text-heading); font-weight: 800;">📚 Subpage / Subject Management</h1>
            <p class="text-secondary mb-0" style="font-size: var(--text-sm);">Create and update course subpages (e.g. /CSC440, /CSC183, /MAT257), edit descriptions, manage notes & playlists, or delete/archive subpages.</p>
        </div>
        <div style="display: flex; gap: 10px;">
            <a href="/Admin/CreateSubpage" class="btn-primary py-1 px-3" style="font-size: 13px;">
                <i class="bi bi-plus-circle-fill"></i> Create New Subpage
            </a>
            <a href="/Admin" class="btn-outline py-1 px-3" style="font-size: 12px;">&larr; Dashboard</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success p-2" style="font-size: 12px;">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Subpages Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--sp-3);">
        @foreach (var course in Model)
        {
            <div class="card p-3" style="display: flex; flex-direction: column; justify-content: space-between; border-top: 3px solid var(--accent);">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
                        <div>
                            <span class="badge bg-success" style="font-size: 12px; font-weight: 800;">c/@course.Code</span>
                            @if (course.IsGeneral)
                            {
                                <span class="badge bg-secondary ms-1">General</span>
                            }
                            else
                            {
                                @foreach (var cd in course.CourseDepartments)
                                {
                                    <span class="badge bg-dark border text-light ms-1">@cd.Department?.Abbreviation</span>
                                }
                            }
                        </div>
                        <a href="/Courses/Details?code=@course.Code" target="_blank" style="font-size: 11px; color: var(--accent); font-weight: 600;">
                            View Live Subpage &nearr;
                        </a>
                    </div>

                    <h5 style="font-weight: 800; color: var(--text-heading); margin-bottom: 4px;">@course.Title</h5>
                    <p style="color: var(--text-secondary); font-size: 12px; height: 36px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; margin-bottom: 12px;">
                        @course.Description
                    </p>

                    <div style="display: flex; gap: 12px; font-size: 11px; color: var(--text-muted); margin-bottom: 16px;">
                        <span><i class="bi bi-file-earmark-text"></i> @course.Resources.Count Notes & Links</span>
                        <span><i class="bi bi-chat-left-text"></i> @course.Posts.Count Posts</span>
                    </div>
                </div>

                <div style="display: flex; gap: 8px; border-top: 1px solid var(--border-default); padding-top: 10px;">
                    <a href="/Admin/EditSubpage/@course.Id" class="btn btn-sm btn-outline-info py-1 px-3" style="flex: 1; font-size: 12px; font-weight: 600;">
                        <i class="bi bi-pencil-square"></i> Edit Subpage
                    </a>

                    <form action="/Admin/DeleteSubpage" method="post" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete subpage c/@course.Code and all associated content?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@course.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 12px;" title="Delete Subpage">
                            <i class="bi bi-trash-fill"></i>
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
