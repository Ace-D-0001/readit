@{
    ViewData["Title"] = "Admin Control Center — ReadIt";
    var recentReports = ViewBag.RecentReports as IEnumerable<Read_It.Models.Report> ?? Enumerable.Empty<Read_It.Models.Report>();
    var recentNotes = ViewBag.RecentPendingNotes as IEnumerable<Read_It.Models.CourseResource> ?? Enumerable.Empty<Read_It.Models.CourseResource>();
    var recentAnnouncements = ViewBag.RecentAnnouncements as IEnumerable<Read_It.Models.Post> ?? Enumerable.Empty<Read_It.Models.Post>();
}

<div style="display: flex; flex-direction: column; gap: var(--sp-4);" class="fade-up">

    <!-- Admin Hero Banner -->
    <div class="hero-card" style="border-top: 4px solid var(--warning); text-align: left; background: linear-gradient(135deg, var(--bg-panel) 0%, rgba(234, 179, 8, 0.05) 100%);">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
            <div>
                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                    <span class="badge bg-warning text-dark font-weight-bold py-1 px-2" style="font-size: 11px;">
                        <i class="bi bi-shield-lock-fill"></i> ReadIt SuperAdmin
                    </span>
                    <span style="font-size: 12px; color: var(--text-muted);">
                        Connected as <strong>@User.Identity?.Name</strong>
                    </span>
                </div>
                <h1 style="font-size: var(--text-2xl); font-weight: 800; color: var(--text-heading); margin-bottom: 4px;">
                    Administrative Command Center
                </h1>
                <p style="color: var(--text-secondary); font-size: var(--text-sm); margin: 0; max-width: 600px;">
                    Oversee student submissions, resolve flagged community reports, maintain course subpages, and broadcast pinned notices.
                </p>
            </div>
            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                <a href="/Admin/CreateAnnouncement" class="btn-warning py-2 px-3" style="font-weight: 700; font-size: 13px;">
                    <i class="bi bi-megaphone-fill"></i> Post Notice
                </a>
                <a href="/Admin/CreateSubpage" class="btn-outline py-2 px-3" style="font-size: 13px;">
                    <i class="bi bi-plus-circle"></i> New Subpage
                </a>
                <a href="/Account/Logout" class="btn btn-outline-danger py-2 px-3" style="font-size: 13px; font-weight: 600;">
                    <i class="bi bi-box-arrow-right"></i> Sign Out
                </a>
            </div>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 p-3" style="font-size: 13px;">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }

    <!-- 6-Metric Executive KPI Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--sp-3);">
        <div class="card p-3" style="border-left: 4px solid #ef4444; background: var(--bg-panel);">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div style="font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Pending Reports</div>
                <i class="bi bi-flag-fill text-danger"></i>
            </div>
            <div style="font-size: 2rem; font-weight: 800; color: #ef4444; margin: 4px 0;">@ViewBag.PendingReports</div>
            <a href="/Admin/Reports?status=Pending" style="font-size: 11px; color: #ef4444; text-decoration: none; font-weight: 600;">Action Reports &rarr;</a>
        </div>

        <div class="card p-3" style="border-left: 4px solid #f59e0b; background: var(--bg-panel);">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div style="font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Pending Notes</div>
                <i class="bi bi-file-earmark-check text-warning"></i>
            </div>
            <div style="font-size: 2rem; font-weight: 800; color: #f59e0b; margin: 4px 0;">@ViewBag.PendingNotes</div>
            <a href="/Admin/Notes?status=Pending" style="font-size: 11px; color: #f59e0b; text-decoration: none; font-weight: 600;">Review Notes &rarr;</a>
        </div>

        <div class="card p-3" style="border-left: 4px solid #3b82f6; background: var(--bg-panel);">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div style="font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Total Students</div>
                <i class="bi bi-people-fill text-primary"></i>
            </div>
            <div style="font-size: 2rem; font-weight: 800; color: var(--text-heading); margin: 4px 0;">@ViewBag.TotalStudents</div>
            <a href="/Admin/Users" style="font-size: 11px; color: #3b82f6; text-decoration: none; font-weight: 600;">Manage Accounts &rarr;</a>
        </div>

        <div class="card p-3" style="border-left: 4px solid #10b981; background: var(--bg-panel);">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div style="font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Subpage Catalog</div>
                <i class="bi bi-journal-album text-success"></i>
            </div>
            <div style="font-size: 2rem; font-weight: 800; color: var(--text-heading); margin: 4px 0;">@ViewBag.TotalCourses</div>
            <a href="/Admin/Subpages" style="font-size: 11px; color: #10b981; text-decoration: none; font-weight: 600;">View Catalog &rarr;</a>
        </div>

        <div class="card p-3" style="border-left: 4px solid #8b5cf6; background: var(--bg-panel);">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div style="font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Posts & Comments</div>
                <i class="bi bi-chat-quote-fill" style="color: #8b5cf6;"></i>
            </div>
            <div style="font-size: 2rem; font-weight: 800; color: var(--text-heading); margin: 4px 0;">@ViewBag.TotalPosts / @ViewBag.TotalComments</div>
            <span style="font-size: 11px; color: var(--text-muted);">Community Discussions</span>
        </div>

        <div class="card p-3" style="border-left: 4px solid #64748b; background: var(--bg-panel);">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div style="font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Banned Accounts</div>
                <i class="bi bi-slash-circle-fill text-secondary"></i>
            </div>
            <div style="font-size: 2rem; font-weight: 800; color: var(--text-heading); margin: 4px 0;">@ViewBag.BannedUsers</div>
            <a href="/Admin/Users?status=banned" style="font-size: 11px; color: var(--text-secondary); text-decoration: none; font-weight: 600;">Ban Roster &rarr;</a>
        </div>
    </div>

    <!-- Admin Navigation Quick Tabs -->
    <div class="dept-tabs mb-0">
        <a href="/Admin" class="dept-tab active"><i class="bi bi-speedometer2"></i> Cockpit Overview</a>
        <a href="/Admin/Reports" class="dept-tab"><i class="bi bi-flag-fill"></i> Content Moderation (@ViewBag.PendingReports)</a>
        <a href="/Admin/Notes" class="dept-tab"><i class="bi bi-journal-check"></i> Notes Approvals (@ViewBag.PendingNotes)</a>
        <a href="/Admin/Subpages" class="dept-tab"><i class="bi bi-folder2-open"></i> Subpages Management</a>
        <a href="/Admin/Users" class="dept-tab"><i class="bi bi-people-fill"></i> User Directory</a>
    </div>

    <!-- Recent Queues Split Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--sp-4);">
        
        <!-- Content Moderation Quick Queue -->
        <div class="card p-3">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <h6 style="font-weight: 800; color: var(--text-heading); margin: 0; display: flex; align-items: center; gap: 6px;">
                    <i class="bi bi-exclamation-triangle-fill text-danger"></i> Urgent Reports Queue
                </h6>
                <a href="/Admin/Reports?status=Pending" style="font-size: 12px; color: var(--accent);">Full Queue &rarr;</a>
            </div>

            @if (recentReports.Any())
            {
                <div style="display: flex; flex-direction: column; gap: 10px;">
                    @foreach (var rep in recentReports)
                    {
                        <div style="background: var(--bg-panel-alt); padding: 12px; border-radius: var(--r-sm); border-left: 3px solid #ef4444;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 4px; font-size: 11px;">
                                <span class="badge bg-danger">@rep.TargetType Report</span>
                                <span style="color: var(--text-muted);">@rep.CreatedAt.ToString("MMM dd, HH:mm")</span>
                            </div>
                            <div style="color: var(--warning); font-weight: 700; font-size: 13px; margin-bottom: 4px;">
                                "@rep.Reason"
                            </div>
                            <div style="font-size: 11px; color: var(--text-secondary); margin-bottom: 8px;">
                                Reported by <strong>u/@(rep.ReportedByUser?.UserName ?? "student")</strong>
                            </div>

                            <form action="/Admin/ResolveReport" method="post" class="d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="reportId" value="@rep.Id" />
                                <button type="submit" name="actionType" value="delete_content" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 11px;" title="Delete Content">
                                    <i class="bi bi-trash-fill"></i> Delete Content
                                </button>
                                <button type="submit" name="actionType" value="reject" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 11px;" title="Dismiss Report">
                                    Dismiss
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center p-4 text-muted" style="font-size: 13px;">
                    <i class="bi bi-shield-check text-success fs-3 d-block mb-2"></i>
                    All caught up! No pending content reports.
                </div>
            }
        </div>

        <!-- Notes Approval Quick Queue -->
        <div class="card p-3">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                <h6 style="font-weight: 800; color: var(--text-heading); margin: 0; display: flex; align-items: center; gap: 6px;">
                    <i class="bi bi-file-earmark-check-fill text-warning"></i> Notes Awaiting Verification
                </h6>
                <a href="/Admin/Notes?status=Pending" style="font-size: 12px; color: var(--accent);">Full Roster &rarr;</a>
            </div>

            @if (recentNotes.Any())
            {
                <div style="display: flex; flex-direction: column; gap: 10px;">
                    @foreach (var note in recentNotes)
                    {
                        <div style="background: var(--bg-panel-alt); padding: 12px; border-radius: var(--r-sm); border-left: 3px solid #f59e0b;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 4px; font-size: 11px;">
                                <span class="badge bg-warning text-dark">c/@(note.Course?.Code ?? "General")</span>
                                <span style="color: var(--text-muted);">@note.CreatedAt.ToString("MMM dd")</span>
                            </div>
                            <div style="color: var(--text-heading); font-weight: 700; font-size: 13px;">
                                @note.Title
                            </div>
                            <div style="font-size: 11px; color: var(--text-secondary); margin-bottom: 8px;">
                                Uploaded by <strong>u/@(note.UploadedByUser?.UserName ?? "student")</strong>
                            </div>

                            <div style="display: flex; gap: 6px;">
                                <form action="/Admin/ApproveNote" method="post" style="margin: 0;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="noteId" value="@note.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-success py-0 px-2" style="font-size: 11px;">
                                        <i class="bi bi-check-lg"></i> Approve
                                    </button>
                                </form>

                                @if (!string.IsNullOrEmpty(note.FilePath))
                                {
                                    <a href="@note.FilePath" target="_blank" class="btn btn-sm btn-outline-info py-0 px-2" style="font-size: 11px;">
                                        <i class="bi bi-file-earmark-pdf"></i> Preview
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center p-4 text-muted" style="font-size: 13px;">
                    <i class="bi bi-journal-check text-success fs-3 d-block mb-2"></i>
                    No pending notes submitted for review.
                </div>
            }
        </div>
    </div>

    <!-- Official Announcements Section -->
    <div class="card p-3">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <h6 style="font-weight: 800; color: var(--text-heading); margin: 0; display: flex; align-items: center; gap: 6px;">
                <i class="bi bi-megaphone-fill text-warning"></i> Active Official Announcements
            </h6>
            <a href="/Admin/CreateAnnouncement" class="btn-warning btn-sm py-1 px-3" style="font-size: 11px; font-weight: 700;">
                + Broadcast New
            </a>
        </div>

        @if (recentAnnouncements.Any())
        {
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 10px;">
                @foreach (var anc in recentAnnouncements)
                {
                    <div style="background: var(--bg-panel-alt); padding: 12px; border-radius: var(--r-sm); border-top: 2px solid var(--warning);">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 4px; font-size: 11px;">
                            <span class="badge bg-warning text-dark">c/@(anc.Course?.Code ?? "General")</span>
                            <span style="color: var(--text-muted);">@anc.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </div>
                        <a href="/Posts/Details/@anc.Id" style="color: var(--text-heading); font-weight: 700; font-size: 13px; text-decoration: none; display: block; margin-bottom: 4px;">
                            @anc.Title
                        </a>
                        <p style="color: var(--text-secondary); font-size: 12px; margin: 0; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @anc.Body
                        </p>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center p-3 text-muted" style="font-size: 12px;">
                No administrative announcements posted yet. Click "+ Broadcast New" to publish rules or notices.
            </div>
        }
    </div>
</div>
