@model IEnumerable<Read_It.Models.Course>

@{
    ViewData["Title"] = "All SubSubjects — ReadIt IUBAT";
    string? searchQuery = ViewBag.SearchQuery as string;
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h1 style="font-size: var(--text-2xl); font-weight: 800; color: var(--text-heading); margin-bottom: var(--sp-1);">All SubSubjects & Courses</h1>
        <p style="color: var(--text-secondary); font-size: var(--text-sm); margin: 0;">Explore every subject community at IUBAT to access course materials, questions, and notes.</p>
    </div>

    <!-- Search Form -->
    <form action="/Courses" method="get" class="d-flex gap-2">
        <input type="text" name="search" value="@searchQuery" placeholder="Search subject code or title..." class="form-control form-control-sm bg-transparent text-white border-secondary" style="width: 240px;" />
        <button type="submit" class="btn-primary py-1 px-3" style="font-size: 12px;">Search</button>
        @if (!string.IsNullOrEmpty(searchQuery))
        {
            <a href="/Courses" class="btn-outline py-1 px-2" style="font-size: 12px;">Clear</a>
        }
    </form>
</div>

<!-- Course Cards Grid -->
@if (Model != null && Model.Any())
{
    <div class="courses-grid">
        @foreach (var course in Model)
        {
            <a href="@Url.Action("Details", "Courses", new { code = course.Code })" class="course-card">
                <div class="course-card-header">
                    <div class="course-card-icon">
                        @course.Code.Substring(0, Math.Min(3, course.Code.Length))
                    </div>
                    <div>
                        <div class="course-card-title">c/@course.Code</div>
                        <div class="course-card-code">@course.Title</div>
                    </div>
                </div>

                <p class="course-card-desc">@course.Description</p>

                <div class="course-card-footer">
                    <div style="display: flex; gap: var(--sp-3); font-size: var(--text-xs); color: var(--text-secondary);">
                        <span><i class="bi bi-file-post"></i> @(course.Posts?.Count ?? 0) posts</span>
                        <span><i class="bi bi-person-check"></i> @(course.Followers?.Count ?? 0) followers</span>
                    </div>
                    <span class="btn btn-sm btn-outline-light py-0 px-2" style="font-size: 11px;">Explore &rarr;</span>
                </div>
            </a>
        }
    </div>
}
else
{
    <div class="empty-state">
        <i class="bi bi-search" style="font-size: 2rem; display: block; margin-bottom: var(--sp-3);"></i>
        <h5>No subjects found</h5>
        <p><a href="@Url.Action("Index", "Courses")" style="color: var(--accent);">View all subjects</a> or try a different search keyword.</p>
    </div>
}
