@model Read_It.Models.Course

@{
    ViewData["Title"] = Model.Code + " — SubReadIt";

    var videosByTopic    = ViewBag.VideosByTopic as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var outlineResources = ViewBag.OutlineResources as IEnumerable<Read_It.Models.CourseResource> ?? Enumerable.Empty<Read_It.Models.CourseResource>();
    var notesResources   = ViewBag.NotesResources as IEnumerable<Read_It.Models.CourseResource> ?? Enumerable.Empty<Read_It.Models.CourseResource>();
    int  followerCount   = ViewBag.FollowerCount ?? 0;
    bool isFollowing     = ViewBag.IsFollowing ?? false;
    string activeSort    = ViewBag.ActiveSort as string ?? "hot";
    var userPostVotes    = ViewBag.UserPostVotes as Dictionary<int, int> ?? new Dictionary<int, int>();
    var userVideoVotes   = ViewBag.UserVideoVotes as List<int> ?? new List<int>();
}

@section RightAside {

<!-- ── Right Column ────────────────────────────────────────────────────────── -->

<!-- Course Outline Links -->
<div class="right-card right-section" data-section-label="outline course outline syllabus">
    <div class="right-card-title" style="justify-content: space-between;">
        <span><i class="bi bi-link-45deg" style="color: var(--accent);"></i> Course Outline</span>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <button class="topic-add-btn" onclick="toggleForm('add-outline-form')">+ add</button>
        }
        else
        {
            <a href="/Account/Login" class="topic-add-btn" style="text-decoration: none;">+ add</a>
        }
    </div>
    @if (outlineResources.Any())
    {
        @foreach (var r in outlineResources)
        {
            <div class="d-flex align-items-center justify-content-between right-col-item mb-1" data-label="@r.Title.ToLower() outline syllabus">
                <a href="@r.Url" target="_blank" rel="noopener noreferrer" class="resource-link" style="flex: 1; min-width: 0;">
                    <i class="bi bi-box-arrow-up-right"></i>
                    <span class="text-truncate">@r.Title</span>
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <form action="/Admin/DeleteResource" method="post" style="margin: 0;" onsubmit="return confirm('Delete this outline link?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="resourceId" value="@r.Id" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button type="submit" class="btn btn-link text-danger p-0 ms-2" title="Delete Outline Link" style="font-size: 11px;">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                }
            </div>
        }
    }
    else
    {
        <p style="color: var(--text-muted); font-size: var(--text-sm); margin: 0;">No outline links yet.</p>
    }

    <!-- Inline Add Outline Form -->
    <div id="add-outline-form" class="add-video-form" style="display: none;">
        <form action="@Url.Action("AddResource", "Courses")" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="code" value="@Model.Code" />
            <input type="hidden" name="type" value="@Read_It.Models.CourseResourceType.Outline" />
            <input type="text" name="title" placeholder="Outline Title (e.g. Notion or Syllabus link)" required class="form-control" style="margin-bottom: var(--sp-2);" />
            <input type="text" name="url"   placeholder="Web URL (e.g. https://... or Notion link)" required class="form-control" style="margin-bottom: var(--sp-2);" />
            <div style="display: flex; gap: var(--sp-2);">
                <button type="submit" class="btn-primary" style="padding: 4px 12px; font-size: 12px;">Add Link</button>
                <button type="button" class="btn-ghost" style="font-size: 12px;" onclick="toggleForm('add-outline-form')">Cancel</button>
            </div>
        </form>
    </div>
</div>

<!-- Approved Student Notes -->
<div class="right-card right-section" data-section-label="notes approved pdf study materials" id="notes">
    <div class="right-card-title" style="justify-content: space-between;">
        <span><i class="bi bi-journal-text" style="color: var(--warning);"></i> Course Notes</span>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <button class="topic-add-btn" onclick="toggleForm('upload-note-form')">+ upload note</button>
        }
        else
        {
            <a href="/Account/Login" class="topic-add-btn" style="text-decoration: none;">+ upload note</a>
        }
    </div>

    <!-- Exam Category Filter Pills -->
    @{
        string activeExamCat = ViewBag.ActiveExamCategory as string ?? "all";
        string currentSort = ViewBag.ActiveSort as string ?? "hot";
    }
    <div class="d-flex flex-wrap gap-1 mb-3 pt-1 border-bottom border-secondary pb-2">
        <a href="/Courses/Details?code=@Model.Code&sort=@currentSort&examCategory=all#notes" class="badge @(activeExamCat == "all" ? "bg-warning text-dark" : "bg-dark text-white border border-secondary") text-decoration-none" style="font-size: 10px; padding: 4px 6px;">All</a>
        <a href="/Courses/Details?code=@Model.Code&sort=@currentSort&examCategory=Midterm#notes" class="badge @(activeExamCat == "Midterm" ? "bg-warning text-dark" : "bg-dark text-white border border-secondary") text-decoration-none" style="font-size: 10px; padding: 4px 6px;">Midterm</a>
        <a href="/Courses/Details?code=@Model.Code&sort=@currentSort&examCategory=Final Exam#notes" class="badge @(activeExamCat == "Final Exam" ? "bg-warning text-dark" : "bg-dark text-white border border-secondary") text-decoration-none" style="font-size: 10px; padding: 4px 6px;">Finals</a>
        <a href="/Courses/Details?code=@Model.Code&sort=@currentSort&examCategory=Lab / Assignment#notes" class="badge @(activeExamCat == "Lab / Assignment" ? "bg-warning text-dark" : "bg-dark text-white border border-secondary") text-decoration-none" style="font-size: 10px; padding: 4px 6px;">Labs</a>
        <a href="/Courses/Details?code=@Model.Code&sort=@currentSort&examCategory=Lecture Notes#notes" class="badge @(activeExamCat == "Lecture Notes" ? "bg-warning text-dark" : "bg-dark text-white border border-secondary") text-decoration-none" style="font-size: 10px; padding: 4px 6px;">Lectures</a>
        <a href="/Courses/Details?code=@Model.Code&sort=@currentSort&examCategory=General#notes" class="badge @(activeExamCat == "General" ? "bg-warning text-dark" : "bg-dark text-white border border-secondary") text-decoration-none" style="font-size: 10px; padding: 4px 6px;">General</a>
    </div>

    @if (notesResources.Any())
    {
        @foreach (var r in notesResources)
        {
            <div class="right-col-item mb-2" data-label="@r.Title.ToLower() notes pdf">
                <div class="d-flex align-items-center justify-content-between">
                    <a href="@(!string.IsNullOrEmpty(r.FilePath) ? r.FilePath : r.Url)" target="_blank" rel="noopener noreferrer"
                       class="resource-link" style="font-weight: 700; color: var(--text-heading); flex: 1; min-width: 0;">
                        <i class="bi bi-file-earmark-pdf-fill" style="color: var(--warning);"></i>
                        <span class="text-truncate">@r.Title</span>
                    </a>
                    <div class="d-flex align-items-center gap-1 ms-2">
                        @if (!string.IsNullOrEmpty(r.ExamCategory))
                        {
                            <span class="badge bg-secondary" style="font-size: 9px; font-weight: 600;">@r.ExamCategory</span>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <form action="/Admin/DeleteResource" method="post" style="margin: 0;" onsubmit="return confirm('Delete this note?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="resourceId" value="@r.Id" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button type="submit" class="btn btn-link text-danger p-0" title="Delete Note" style="font-size: 11px;">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(r.Description))
                {
                    <div style="font-size: 11px; color: var(--text-secondary); margin-left: 20px; line-height: 1.3;">@r.Description</div>
                }
            </div>
        }
    }
    else
    {
        <p style="color: var(--text-muted); font-size: var(--text-sm); margin: 0;">No approved notes found in this category.</p>
    }

    <!-- Inline Upload Note Form -->
    <div id="upload-note-form" class="add-video-form" style="display: none; margin-top: 12px;">
        <form action="/Courses/UploadNote" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="code" value="@Model.Code" />
            <input type="text" name="title" placeholder="Note Title (e.g. Midterm Chapter 1-4 Summary)" required class="form-control mb-2" style="font-size: 12px;" />
            <textarea name="description" placeholder="Short description of notes..." class="form-control mb-2" rows="2" style="font-size: 11px;"></textarea>

            <div class="mb-2">
                <label style="font-size: 10px; color: var(--text-muted); display: block; margin-bottom: 2px;">Exam & Study Category:</label>
                <select name="examCategory" class="form-select form-select-sm bg-dark text-white border-secondary" style="font-size: 11px;">
                    <option value="Lecture Notes" selected>Lecture Notes & Slides</option>
                    <option value="Midterm">Midterm Exam Preparation</option>
                    <option value="Final Exam">Final Exam Comprehensive</option>
                    <option value="Lab / Assignment">Lab / Assignment Solution</option>
                    <option value="General">General Study Material</option>
                </select>
            </div>

            <div class="mb-2">
                <label style="font-size: 10px; color: var(--text-muted); display: block; margin-bottom: 2px;">Upload PDF or Document File:</label>
                <input type="file" name="file" accept=".pdf,.doc,.docx,.ppt,.pptx,.png,.jpg" class="form-control form-control-sm" style="font-size: 11px;" />
            </div>

            <div class="mb-2 text-center" style="font-size: 10px; color: var(--text-muted);">- OR -</div>

            <input type="text" name="url" placeholder="External Google Drive / Web Link" class="form-control mb-2" style="font-size: 11px;" />

            <div style="font-size: 10px; color: var(--accent); margin-bottom: 8px;">
                <i class="bi bi-check-circle-fill"></i> Uploaded notes are immediately available to all students.
            </div>

            <div style="display: flex; gap: var(--sp-2);">
                <button type="submit" class="btn-primary" style="padding: 4px 12px; font-size: 12px;">Submit Note</button>
                <button type="button" class="btn-ghost" style="font-size: 12px;" onclick="toggleForm('upload-note-form')">Cancel</button>
            </div>
        </form>
    </div>
</div>

@if (User.IsInRole("Admin"))
{
    <!-- Admin Subpage Control -->
    <div class="right-card">
        <div style="border-left: 3px solid var(--warning); padding-left: 8px;">
            <div style="font-size: 11px; font-weight: 700; color: var(--warning); text-transform: uppercase; margin-bottom: 6px;">
                <i class="bi bi-shield-lock-fill"></i> Admin Subpage Controls
            </div>
            <div style="display: flex; flex-direction: column; gap: 6px;">
                <a href="/Admin/EditSubpage/@Model.Id" class="btn btn-sm btn-outline-info py-1 px-2" style="font-size: 12px; font-weight: 600;">
                    <i class="bi bi-pencil-square"></i> Edit Subject Subpage
                </a>
                <a href="/Admin/CreateAnnouncement?courseCode=@Model.Code" class="btn btn-sm btn-warning py-1 px-2" style="font-size: 12px; font-weight: 700;">
                    <i class="bi bi-megaphone-fill"></i> Broadcast Notice
                </a>
            </div>
        </div>
    </div>
}

<!-- YouTube Videos by Topic -->
<div class="right-card right-section" data-section-label="video youtube">
    <div class="right-card-title">
        <i class="bi bi-youtube" style="color: #ff0000;"></i> Best Videos by Topic
    </div>

    @if (videosByTopic != null && videosByTopic.Cast<object>().Any())
    {
        @foreach (var group in videosByTopic)
        {
            var topicVideos = group.Videos as IEnumerable<Read_It.Models.CourseVideo>;
            if (topicVideos == null) continue;
            var videoList = topicVideos.ToList();
            string topicName = group.Topic as string ?? "";

            <div class="right-section" data-section-label="@topicName.ToLower() video youtube">
                <div class="topic-heading">
                    <span class="topic-name">📌 @topicName</span>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <button class="topic-add-btn" onclick="toggleForm('add-video-form-@(Uri.EscapeDataString(topicName))')">+ add</button>
                    }
                    else
                    {
                        <a href="/Account/Login" class="topic-add-btn" style="text-decoration: none;">+ add</a>
                    }
                </div>

                @for (int i = 0; i < videoList.Count; i++)
                {
                    var video   = videoList[i];
                    bool isBest = i == 0;

                    <div class="video-entry right-col-item d-flex align-items-center" data-label="@video.Title.ToLower() @topicName.ToLower() video">
                        <div class="video-upvote-col">
                            @{
                                bool hasVotedVideo = userVideoVotes.Contains(video.Id);
                            }
                            <button type="button" class="vote-arrow up @(hasVotedVideo ? "upvoted" : "")"
                                    onclick="upvoteVideo(this, @video.Id, '@Model.Code')"
                                    title="Upvote" style="background: none; border: none; padding: 0; cursor: pointer; font-size: 14px; @(hasVotedVideo ? "color: var(--accent);" : "")">
                                <i class="bi bi-arrow-up-circle-fill"></i>
                            </button>
                            <span class="video-upvote-count" style="font-size: 10px; color: var(--text-muted);">@video.UpVotes</span>
                        </div>
                        <div style="flex: 1; min-width: 0;">
                            <a href="@video.VideoUrl" target="_blank" rel="noopener noreferrer" class="video-link @(isBest ? "best" : "")">
                                @if (isBest)
                                {
                                    <i class="bi bi-star-fill" style="color: gold; flex-shrink: 0; margin-top: 2px; font-size: 10px;"></i>
                                }
                                else
                                {
                                    <i class="bi bi-play-circle" style="color: var(--text-muted); flex-shrink: 0; margin-top: 2px; font-size: 11px;"></i>
                                }
                                <span style="overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">@video.Title</span>
                            </a>
                            @if (isBest)
                            {
                                <div style="font-size: 10px; color: gold; margin-top: 2px;">⭐ Best in topic</div>
                            }
                        </div>
                        @if (User.IsInRole("Admin"))
                        {
                            <form action="/Admin/DeleteVideo" method="post" style="margin: 0;" onsubmit="return confirm('Delete this video?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="videoId" value="@video.Id" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button type="submit" class="btn btn-link text-danger p-0 ms-2" title="Delete Video" style="font-size: 11px;">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        }
                    </div>
                }

                <div id="add-video-form-@(Uri.EscapeDataString(topicName))" class="add-video-form" style="display: none;">
                    <form action="@Url.Action("AddVideo", "Courses")" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="code"  value="@Model.Code" />
                        <input type="hidden" name="topic" value="@topicName" />
                        <input type="text" name="title"    placeholder="Video title" required class="form-control" style="margin-bottom: var(--sp-2);" />
                        <input type="text" name="videoUrl" placeholder="YouTube URL (e.g. https://...)" required class="form-control" style="margin-bottom: var(--sp-2);" />
                        <div style="display: flex; gap: var(--sp-2);">
                            <button type="submit" class="btn-primary" style="padding: 4px 12px; font-size: 12px;">Add</button>
                            <button type="button" class="btn-ghost" style="font-size: 12px;" onclick="toggleForm('add-video-form-@(Uri.EscapeDataString(topicName))')">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    }
    else
    {
        <p style="color: var(--text-muted); font-size: var(--text-sm); margin: 0;">No videos submitted yet.</p>
    }

    <div style="border-top: 1px solid var(--border-default); margin-top: var(--sp-3); padding-top: var(--sp-3);">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <button class="action-btn" style="font-size: var(--text-xs); color: var(--accent); width: 100%; justify-content: center;"
                    onclick="toggleForm('new-topic-form')">
                <i class="bi bi-plus-circle"></i> Submit video under new topic
            </button>
            <div id="new-topic-form" class="add-video-form" style="display: none;">
                <form action="@Url.Action("AddVideo", "Courses")" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="code" value="@Model.Code" />
                    <input type="text" name="topic"    placeholder="Topic (e.g. Recursion)" required class="form-control" style="margin-bottom: var(--sp-2);" />
                    <input type="text" name="title"    placeholder="Video title"            required class="form-control" style="margin-bottom: var(--sp-2);" />
                    <input type="text" name="videoUrl" placeholder="YouTube URL (e.g. https://...)" required class="form-control" style="margin-bottom: var(--sp-2);" />
                    <button type="submit" class="btn-primary" style="padding: 4px 14px; font-size: 12px;">Submit</button>
                </form>
            </div>
        }
        else
        {
            <a href="/Account/Login" class="action-btn" style="font-size: var(--text-xs); color: var(--accent); width: 100%; justify-content: center; text-decoration: none;">
                <i class="bi bi-plus-circle"></i> Sign in to submit a video
            </a>
        }
    </div>
</div>



<script>
function filterRightCol(q) {
    q = q.toLowerCase().trim();
    document.querySelectorAll('.right-col-item').forEach(el => {
        const label = (el.dataset.label || '') + ' ' + el.innerText.toLowerCase();
        el.style.display = (!q || label.includes(q)) ? '' : 'none';
    });
    document.querySelectorAll('.right-section').forEach(section => {
        const visItems = section.querySelectorAll('.right-col-item:not([style*="display: none"])');
        section.style.display = (!q || section.dataset.sectionLabel?.includes(q) || visItems.length > 0) ? '' : 'none';
    });
}
function toggleForm(id) {
    const el = document.getElementById(id);
    if (el) el.style.display = el.style.display === 'none' ? 'block' : 'none';
}

async function upvoteVideo(btn, videoId, code) {
    try {
        const res = await fetch(`/Courses/UpvoteVideo?videoId=${videoId}&code=${encodeURIComponent(code)}`, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        const data = await res.json();
        if (data.requireAuth) {
            window.location.href = '/Account/Login';
            return;
        }
        if (data.success) {
            const countEl = btn.parentElement.querySelector('.video-upvote-count');
            if (countEl) countEl.textContent = data.upVotes;
            if (data.hasVoted) {
                btn.classList.add('upvoted');
                btn.style.color = 'var(--accent)';
            } else {
                btn.classList.remove('upvoted');
                btn.style.color = '';
            }
        }
    } catch (err) {
        console.error('Video upvote failed:', err);
    }
}

async function toggleCourseFollow(btn, code) {
    try {
        const res = await fetch(`/Courses/Follow?code=${encodeURIComponent(code)}`, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        const data = await res.json();
        if (data.requireAuth) {
            window.location.href = '/Account/Login';
            return;
        }
        if (data.success) {
            const badge = document.getElementById('course-follower-badge');
            if (badge) {
                badge.innerHTML = `<i class="bi bi-people-fill"></i> ${data.followerCount} ${data.followerCount === 1 ? 'follower' : 'followers'}`;
            }
            if (data.isFollowing) {
                btn.className = 'btn btn-outline-secondary';
                btn.innerHTML = '<i class="bi bi-check-circle-fill text-success"></i> <span>Following</span>';
            } else {
                btn.className = 'btn btn-outline-primary';
                btn.innerHTML = '<i class="bi bi-plus-lg"></i> <span>Follow</span>';
            }
        }
    } catch (e) {
        console.error('Follow failed', e);
    }
}
</script>
}

<!-- ══════════════════════════════════════════════════════════════════════════
     MAIN CENTER COLUMN
     ══════════════════════════════════════════════════════════════════════════ -->

<!-- Course Header Banner -->
<div class="course-banner fade-up">
    <div class="course-banner-gradient"></div>
    <div class="course-banner-body">
        <div class="course-banner-icon">
            @Model.Code.Substring(0, Math.Min(3, Model.Code.Length))
        </div>
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: var(--sp-3); width: 100%;">
            <div style="flex: 1; min-width: 260px;">
                <div style="display: flex; align-items: center; gap: var(--sp-2); flex-wrap: wrap; margin-bottom: var(--sp-1);">
                    <h1 style="font-size: var(--text-xl); font-weight: 800; color: var(--text-heading); margin: 0;">
                        c/@Model.Code — @Model.Title
                    </h1>
                    <span id="course-follower-badge" class="badge" style="background: rgba(255, 69, 0, 0.12); color: var(--accent); border: 1px solid rgba(255, 69, 0, 0.3); font-size: 11px; padding: 4px 10px; border-radius: 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 5px;">
                        <i class="bi bi-people-fill"></i> @followerCount @(followerCount == 1 ? "follower" : "followers")
                    </span>
                </div>
                <p style="color: var(--text-secondary); font-size: var(--text-sm); margin: 0; max-width: 600px; line-height: 1.6;">@Model.Description</p>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                    <a href="/Admin/CreateAnnouncement?courseCode=@Model.Code" class="btn-warning py-2 px-3" style="font-size: 13px; font-weight: 700; border-radius: 8px;">
                        <i class="bi bi-megaphone-fill"></i> Post Notice
                    </a>
                    <a href="/Admin/EditSubpage/@Model.Id" class="btn-outline py-2 px-3" style="font-size: 13px; border-radius: 8px;">
                        <i class="bi bi-gear-fill"></i> Manage
                    </a>
                </div>
            }
            else
            {
                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                    <button type="button" id="course-follow-btn" onclick="toggleCourseFollow(this, '@Model.Code')"
                            class="btn @(isFollowing ? "btn-outline-secondary" : "btn-outline-primary")"
                            style="border-radius: 20px; font-size: 13px; font-weight: 600; padding: 6px 16px; display: inline-flex; align-items: center; gap: 6px;">
                        <i class="bi @(isFollowing ? "bi-check-circle-fill text-success" : "bi-plus-lg")"></i>
                        <span>@(isFollowing ? "Following" : "Follow")</span>
                    </button>

                    <a href="@Url.Action("Create", "Posts", new { courseCode = Model.Code })" class="btn-primary" style="border-radius: 20px; font-size: 13px; padding: 6px 18px; display: inline-flex; align-items: center; gap: 6px;">
                        <i class="bi bi-pencil-square"></i> Create Post
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Post Feed Header & Sorting -->
<div class="feed-label">
    <h6>Subject Feed</h6>
    <div class="dept-tabs" style="margin-bottom: 0;">
        <a href="@Url.Action("Details", "Courses", new { code = Model.Code, sort = "hot" })" class="dept-tab @(activeSort == "hot" ? "active" : "")">
            <i class="bi bi-fire"></i> Hot
        </a>
        <a href="@Url.Action("Details", "Courses", new { code = Model.Code, sort = "top" })" class="dept-tab @(activeSort == "top" ? "active" : "")">
            <i class="bi bi-star"></i> Top
        </a>
        <a href="@Url.Action("Details", "Courses", new { code = Model.Code, sort = "new" })" class="dept-tab @(activeSort == "new" ? "active" : "")">
            <i class="bi bi-sparkles"></i> New
        </a>
    </div>
</div>

<!-- Posts Feed -->
@if (Model.Posts != null && Model.Posts.Any())
{
    <div style="display: flex; flex-direction: column; gap: var(--sp-3);">
        @foreach (var post in Model.Posts)
        {
            int myVote = userPostVotes.ContainsKey(post.Id) ? userPostVotes[post.Id] : 0;
            string authorName = post.User?.UserName ?? "student";
            string flairClass = "flair-" + post.Flair.ToString().ToLower();
            bool isAdmin = User.IsInRole("Admin");

            <article class="post-card fade-up" onclick="if (!event.target.closest('a, button, input, form')) window.location.href='@Url.Action("Details", "Posts", new { id = post.Id })';">
                <div class="post-vote-col">
                    @if (!isAdmin)
                    {
                        <button class="vote-arrow up @(myVote == 1 ? "upvoted" : "")" type="button" title="Upvote" onclick="asyncVote(this, @post.Id, 'post', 1, event)">
                            <i class="bi bi-arrow-up-circle-fill"></i>
                        </button>

                        <span class="vote-count @(myVote == 1 ? "text-accent" : "")">@(post.UpVotes - post.DownVotes)</span>

                        <button class="vote-arrow down @(myVote == -1 ? "downvoted" : "")" type="button" title="Downvote" onclick="asyncVote(this, @post.Id, 'post', -1, event)">
                            <i class="bi bi-arrow-down-circle-fill"></i>
                        </button>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark font-weight-bold" style="font-size: 9px; writing-mode: vertical-rl; transform: rotate(180deg); padding: 4px 2px;">
                            MOD
                        </span>
                        <span class="vote-count text-muted mt-1" style="font-size: 10px;">@(post.UpVotes - post.DownVotes)</span>
                    }
                </div>
                <div class="post-body-col">
                    <div class="post-meta">
                        <span class="avatar avatar-sm" style="background: @(authorName == "admin" ? "var(--warning)" : "var(--accent)"); color: @(authorName == "admin" ? "#000" : "#fff"); font-weight: 800; width: 22px; height: 22px; font-size: 10px;">
                            @authorName.Substring(0, 1).ToUpper()
                        </span>
                        <a href="@Url.Action("Details", "User", new { username = authorName })" style="color: var(--text-heading); font-weight: 700;">
                            u/@authorName
                        </a>
                        @if (authorName == "admin")
                        {
                            <span class="badge bg-warning text-dark font-weight-bold" style="font-size: 9px; padding: 1px 4px;">ADMIN</span>
                        }
                        <span>·</span>
                        <span>c/@Model.Code</span>
                        <span class="flair-badge @flairClass">@post.Flair.ToString()</span>
                        @if (post.IsPinned)
                        {
                            <span class="badge bg-warning text-dark font-weight-bold" style="font-size: 10px;"><i class="bi bi-pin-angle-fill"></i> Pinned</span>
                        }
                        <span>·</span>
                        <span>@post.CreatedAt.ToString("MMM dd")</span>
                    </div>

                    <a href="@Url.Action("Details", "Posts", new { id = post.Id })" class="post-title">
                        @post.Title
                    </a>
                    <p class="post-preview">@post.Body</p>

                    <div class="post-actions flex-wrap">
                        <a href="@Url.Action("Details", "Posts", new { id = post.Id })" class="action-btn">
                            <i class="bi bi-chat-left-text-fill" style="color: var(--accent);"></i>
                            @(post.Comments?.Count ?? 0) Comments
                        </a>
                        <a href="@Url.Action("Details", "Posts", new { id = post.Id })" class="action-btn">
                            <i class="bi bi-arrow-right-circle"></i> Read Full
                        </a>
                        <button class="action-btn" style="margin-left: auto;" onclick="navigator.clipboard.writeText(window.location.origin + '/Posts/Details/@post.Id'); alert('Post link copied!');">
                            <i class="bi bi-link-45deg"></i> Copy Link
                        </button>
                        @if (isAdmin)
                        {
                            <form action="/Admin/DeletePost" method="post" style="margin: 0;" onsubmit="return confirm('Delete this post?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="postId" value="@post.Id" />
                                <button type="submit" class="action-btn" style="color: var(--error);" title="Delete Post">
                                    <i class="bi bi-trash-fill"></i>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </article>
        }
    </div>
}
else
{
    <div class="empty-state">
        <i class="bi bi-chat-square" style="font-size: 2.5rem; display: block; margin-bottom: var(--sp-3);"></i>
        <h5>No posts in c/@Model.Code yet</h5>
        <p><a href="@Url.Action("Create", "Posts", new { courseCode = Model.Code })" style="color: var(--accent);">Create the first post</a> in this subReadIt!</p>
    </div>
}
