@{
    ViewData["Title"] = "Forgot Password — ReadIt";
}

<div style="max-width: 440px; margin: 40px auto;" class="fade-up">
    <div class="card p-4 shadow-lg">
        <div class="text-center mb-4">
            <h2 style="font-weight: 800; color: var(--text-heading);">Forgot Password</h2>
            <p style="color: var(--text-secondary); font-size: var(--text-sm);">Enter your registered email address to receive a password reset link.</p>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.Message as string))
        {
            <div class="alert alert-info p-2 mb-3" style="font-size: var(--text-xs); border-radius: var(--r-sm);">
                @ViewBag.Message
            </div>
        }

        <form action="/Account/ForgotPassword" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label style-label">Account Email</label>
                <input type="email" name="email" class="form-control" placeholder="e.g. student@iubat.edu" required />
            </div>

            <button type="submit" class="btn-primary w-100 py-2 mt-2">Generate Reset Link</button>
        </form>

        <div class="text-center mt-4 pt-3" style="border-top: 1px solid var(--border-default); font-size: var(--text-xs); color: var(--text-secondary);">
            Remembered your password? <a href="/Account/Login" style="color: var(--accent); font-weight: 700;">Sign In</a>
        </div>
    </div>
</div>
