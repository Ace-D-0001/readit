@{
    ViewData["Title"] = "Reset Password — ReadIt";
}

<div style="max-width: 440px; margin: 40px auto;" class="fade-up">
    <div class="card p-4 shadow-lg">
        <div class="text-center mb-4">
            <h2 style="font-weight: 800; color: var(--text-heading);">Set New Password</h2>
            <p style="color: var(--text-secondary); font-size: var(--text-sm);">Enter your new password below.</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger p-2 mb-3" style="font-size: var(--text-xs); border-radius: var(--r-sm);">
                @Html.ValidationSummary(false, "", new { @class = "mb-0" })
            </div>
        }

        <form action="/Account/ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="email" value="@ViewBag.Email" />
            <input type="hidden" name="token" value="@ViewBag.Token" />

            <div class="mb-3">
                <label class="form-label style-label">Email</label>
                <input type="email" value="@ViewBag.Email" class="form-control" disabled />
            </div>

            <div class="mb-3">
                <label class="form-label style-label">New Password</label>
                <input type="password" name="newPassword" class="form-control" placeholder="••••••••" required />
            </div>

            <button type="submit" class="btn-primary w-100 py-2 mt-2">Reset Password</button>
        </form>
    </div>
</div>
