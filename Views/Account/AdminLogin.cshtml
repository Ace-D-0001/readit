@{
    ViewData["Title"] = "Admin Portal Sign In — ReadIt";
}

<div style="max-width: 440px; margin: 40px auto;" class="fade-up">
    <div class="card p-4 shadow-lg" style="border-top: 3px solid var(--warning);">
        <div class="text-center mb-4">
            <span class="avatar avatar-md mb-2" style="background: rgba(234, 179, 8, 0.2); color: var(--warning); font-size: 20px;">
                <i class="bi bi-shield-lock-fill"></i>
            </span>
            <h2 style="font-weight: 800; color: var(--text-heading);">Admin Portal Sign In</h2>
            <p style="color: var(--text-secondary); font-size: var(--text-sm);">Moderation, Reports, Notes Approval & Subpage Management</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success p-2 mb-3" style="font-size: var(--text-xs); border-radius: var(--r-sm);">
                <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger p-2 mb-3" style="font-size: var(--text-xs); border-radius: var(--r-sm);">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger p-2 mb-3" style="font-size: var(--text-xs); border-radius: var(--r-sm);">
                @Html.ValidationSummary(false, "", new { @class = "mb-0" })
            </div>
        }

        <!-- Quick Test Admin Credentials -->
        <div style="background: rgba(234, 179, 8, 0.08); border: 1px dashed rgba(234, 179, 8, 0.3); border-radius: var(--r-md); padding: 12px; margin-bottom: 20px; text-align: center;">
            <div style="font-size: var(--text-xs); font-weight: 700; color: var(--warning); margin-bottom: 4px;">
                🛡️ TEST ADMIN CREDENTIALS
            </div>
            <div style="font-size: 11px; color: var(--text-muted); display: flex; justify-content: center; align-items: center; gap: 8px;">
                <span><code>admin@iubat.edu</code></span>
                <button type="button" class="btn btn-outline-warning btn-xs" style="padding: 1px 6px; font-size: 10px;" onclick="fillAdminCredentials()">Fill Form</button>
            </div>
        </div>

        <form action="/Account/AdminLogin" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="mb-3">
                <label class="form-label style-label">Admin Email or Username</label>
                <input type="text" id="adminEmail" name="email" class="form-control" placeholder="admin@iubat.edu" required />
            </div>

            <div class="mb-3">
                <label class="form-label style-label">Admin Password</label>
                <input type="password" id="adminPassword" name="password" class="form-control" placeholder="••••••••" required />
            </div>

            <button type="submit" class="btn btn-warning w-100 py-2 mt-2" style="font-weight: 700;">
                <i class="bi bi-shield-check"></i> Sign In to Admin Dashboard
            </button>
        </form>

        <div class="text-center mt-4 pt-3" style="border-top: 1px solid var(--border-default); font-size: var(--text-xs); color: var(--text-secondary);">
            Are you a student? <a href="/Account/Login" style="color: var(--accent); font-weight: 700;">Student Sign In &rarr;</a>
        </div>
    </div>
</div>

<script>
function fillAdminCredentials() {
    document.getElementById('adminEmail').value = 'admin@iubat.edu';
    document.getElementById('adminPassword').value = 'Admin123!';
}
</script>
