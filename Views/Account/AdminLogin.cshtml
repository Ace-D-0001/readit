@{
    ViewData["Title"] = "Admin Portal Sign In — StudyHub";
}

<div style="max-width: 440px; margin: 48px auto;" class="fade-up">
    <!-- Brand Icon & Header -->
    <div class="text-center mb-4">
        <div style="display: inline-flex; align-items: center; justify-content: center; width: 52px; height: 52px; border-radius: 12px; background: rgba(234, 179, 8, 0.12); border: 1px solid rgba(234, 179, 8, 0.25); margin-bottom: 16px;">
            <i class="bi bi-shield-lock-fill" style="font-size: 26px; color: var(--warning);"></i>
        </div>
        <div class="d-flex align-items-center justify-content-center gap-2 mb-1">
            <h2 style="font-weight: 700; color: var(--text-heading); margin: 0; font-size: 1.5rem; letter-spacing: -0.025em;">StudyHub Admin Portal</h2>
        </div>
        <p style="color: var(--text-secondary); font-size: 13.5px; margin: 0; line-height: 1.5;">Authorized access for content moderation, approvals, and platform administration.</p>
    </div>

    <!-- Portal Switch Tabs -->
    <div class="dept-tabs justify-content-center mb-3" style="border-radius: var(--r-md); background: var(--bg-panel); padding: 4px; border: 1px solid var(--border-default);">
        <a href="/Account/Login" class="dept-tab" style="flex: 1; text-align: center; border-radius: var(--r-sm); justify-content: center; color: var(--text-secondary); font-weight: 500;">
            <i class="bi bi-person-fill"></i> Student Portal
        </a>
        <a href="/Account/AdminLogin" class="dept-tab active" style="flex: 1; text-align: center; border-radius: var(--r-sm); justify-content: center; color: var(--warning); font-weight: 600; border-color: rgba(234, 179, 8, 0.35);">
            <i class="bi bi-shield-lock-fill"></i> Admin Portal
        </a>
    </div>

    <div class="card p-4 shadow-sm" style="border-radius: var(--r-lg); border: 1px solid var(--border-default); border-top: 3px solid var(--warning); background: var(--bg-panel);">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success d-flex align-items-center gap-2 p-2 mb-3" style="font-size: 12.5px; border-radius: var(--r-sm);">
                <i class="bi bi-check-circle-fill fs-6 text-success"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 p-2 mb-3" style="font-size: 12.5px; border-radius: var(--r-sm);">
                <i class="bi bi-exclamation-triangle-fill fs-6 text-danger"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger p-2 mb-3" style="font-size: 12.5px; border-radius: var(--r-sm);">
                @Html.ValidationSummary(false, "", new { @class = "mb-0" })
            </div>
        }

        <!-- Continue with Google (Admin) -->
        <a href="/Account/GoogleLogin?role=Admin@(ViewData["ReturnUrl"] != null ? "&returnUrl=" + Uri.EscapeDataString(ViewData["ReturnUrl"]!.ToString()!) : "")" class="btn w-100 mb-3" style="background: #ffffff; color: #111827; font-weight: 600; border: 1px solid #e5e7eb; display: flex; align-items: center; justify-content: center; gap: 10px; font-size: 13.5px; padding: 10px 16px; border-radius: var(--r-md); transition: background 0.15s ease, box-shadow 0.15s ease;">
            <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
            <span>Continue with Google</span>
        </a>

        <!-- Separator -->
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
            <hr style="flex: 1; border-color: var(--border-default); margin: 0;" />
            <span style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Or enter admin credentials</span>
            <hr style="flex: 1; border-color: var(--border-default); margin: 0;" />
        </div>

        <form action="/Account/AdminLogin" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="mb-3">
                <label class="form-label" style="font-size: 12.5px; font-weight: 600; color: var(--text-heading); margin-bottom: 6px;">Admin Email or Username</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-secondary text-muted" style="border-color: var(--border-default) !important;">
                        <i class="bi bi-shield-check text-warning"></i>
                    </span>
                    <input type="text" id="adminEmail" name="email" class="form-control" placeholder="admin@gmail.com" required autofocus />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label" style="font-size: 12.5px; font-weight: 600; color: var(--text-heading); margin-bottom: 6px;">Admin Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-secondary text-muted" style="border-color: var(--border-default) !important;">
                        <i class="bi bi-key"></i>
                    </span>
                    <input type="password" id="adminPassword" name="password" class="form-control" placeholder="Enter admin password" required />
                    <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('adminPassword', 'adminEyeIcon')" style="border-color: var(--border-default); color: var(--text-muted);" title="Toggle password visibility">
                        <i class="bi bi-eye" id="adminEyeIcon"></i>
                    </button>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="rememberMe" value="true" id="adminRememberMe" checked />
                    <label class="form-check-label" for="adminRememberMe" style="font-size: 12.5px; color: var(--text-secondary);">
                        Remember administrative session
                    </label>
                </div>
            </div>

            <button type="submit" class="btn btn-warning w-100 py-2" style="font-size: 14px; font-weight: 700; border-radius: var(--r-md); color: #111827;">
                Sign In to Admin Portal
            </button>
        </form>

        <div class="text-center mt-4 pt-3" style="border-top: 1px solid var(--border-default); font-size: 12.5px; color: var(--text-secondary);">
            Looking for standard student access? <a href="/Account/Login" style="color: var(--accent); font-weight: 600; text-decoration: none;">Student Portal &rarr;</a>
        </div>
    </div>
</div>

<script>
function togglePasswordVisibility(inputId, iconId) {
    const input = document.getElementById(inputId);
    const icon = document.getElementById(iconId);
    if (!input || !icon) return;
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('bi-eye');
        icon.classList.add('bi-eye-slash');
    } else {
        input.type = 'password';
        icon.classList.remove('bi-eye-slash');
        icon.classList.add('bi-eye');
    }
}
</script>
